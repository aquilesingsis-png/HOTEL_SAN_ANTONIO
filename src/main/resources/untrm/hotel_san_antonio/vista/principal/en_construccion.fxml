<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Se muestra en el marco principal cuando el modulo elegido todavia no tiene su pantalla. Sin archivo .css. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER" spacing="8" style="-fx-background-color: #F8F6F2;">

    <Label text="Módulo en construcción" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <Label text="Esta pantalla aparecerá aquí cuando el módulo esté listo." style="-fx-text-fill: #777777;"/>
</VBox>
