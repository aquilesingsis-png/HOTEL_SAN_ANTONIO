<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Reportes: ocupacion, ingresos y ventas de tienda en una sola pantalla. Se elige el reporte, el periodo
     y como agrupar; abajo salen los totales, el grafico y la tabla, que se pueden guardar en Excel o PDF. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.ReportesController" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" style="-fx-background: #F8F6F2; -fx-background-color: #F8F6F2; -fx-background-insets: 0; -fx-padding: 0;">
            <content>
                <VBox spacing="18" fillWidth="true" style="-fx-padding: 20 24 26 24; -fx-background-color: #F8F6F2;">
                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="Reporte" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <FlowPane hgap="12" vgap="12">
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Tipo de reporte" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <ChoiceBox fx:id="cmbReporte" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="180">
                                <Label text="Desde" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="dpDesde" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="180">
                                <Label text="Hasta" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="dpHasta" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="190">
                                <Label fx:id="lblFiltro1" text="Tipo de habitación" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <ChoiceBox fx:id="cmbFiltro1" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                            </VBox>
                            <VBox fx:id="boxFiltro2" spacing="6" prefWidth="170" visible="false" managed="false">
                                <Label fx:id="lblFiltro2" text="Medio de pago" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <ChoiceBox fx:id="cmbFiltro2" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                            </VBox>
                            <VBox fx:id="boxBuscar" spacing="6" prefWidth="230" visible="false" managed="false">
                                <Label text="Buscar producto o código" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtBuscar" promptText="Nombre o código de barras" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="170">
                                <Label text="Agrupar por" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <ChoiceBox fx:id="cmbAgrupar" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                            </VBox>
                        </FlowPane>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Generar reporte" onAction="#generar" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
                            <Button text="Limpiar filtros" onAction="#limpiar" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Exportar Excel" onAction="#exportarExcel" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                            <Button text="Imprimir / PDF" onAction="#exportarPdf" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                        </HBox>
                    </VBox>

                    <FlowPane hgap="12" vgap="12">
                        <VBox spacing="8" prefWidth="250" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                            <Label fx:id="lblTotal1" text="—" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                            <Label fx:id="lblValor1" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        </VBox>
                        <VBox spacing="8" prefWidth="250" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                            <Label fx:id="lblTotal2" text="—" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                            <Label fx:id="lblValor2" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        </VBox>
                        <VBox spacing="8" prefWidth="250" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                            <Label fx:id="lblTotal3" text="—" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                            <Label fx:id="lblValor3" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        </VBox>
                    </FlowPane>

                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label fx:id="lblTituloGrafico" text="Gráfico" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <BarChart fx:id="grafico" minHeight="260" prefHeight="300">
                            <xAxis>
                                <CategoryAxis/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis forceZeroInRange="true"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label fx:id="lblCantidad" text="0 filas" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <TableView fx:id="tabla" minHeight="260" prefHeight="420" userData="tabla-nuevos" style="-fx-background-color: white; -fx-border-color: #E8E2D9; -fx-border-color: #E7E1D8; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0; -fx-fixed-cell-size: 40;">
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8">
                                    <Label text="Sin datos para mostrar" style="-fx-text-fill: #5A3516; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                                    <Label text="Cambia el período o los filtros y pulsa Generar reporte." style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
