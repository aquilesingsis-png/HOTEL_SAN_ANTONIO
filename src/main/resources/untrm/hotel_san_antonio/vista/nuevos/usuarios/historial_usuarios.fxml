<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: historial de cambios de usuarios (solo Administrador). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.HistorialUsuariosController"
      spacing="12" prefWidth="940" prefHeight="620" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
    <Label text="Historial de usuarios" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <TextField fx:id="txtBuscar" promptText="Buscar por usuario, acción, detalle o quién lo hizo" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
    <Label fx:id="lblCantidad" text="TOTAL DE REGISTROS: 0" style="-fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" userData="tabla-nuevos" style="-fx-background-color: white; -fx-border-color: #E8E2D9; -fx-border-color: #E7E1D8; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0; -fx-fixed-cell-size: 40;">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="130" minWidth="100"/>
            <TableColumn fx:id="colAfectado" text="Usuario afectado" prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="colAccion" text="Acción" prefWidth="210" minWidth="120"/>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="270" minWidth="120"/>
            <TableColumn fx:id="colRealizadoPor" text="Realizado por" prefWidth="130" minWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Aún no hay cambios registrados." style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
        </placeholder>
    </TableView>
    <HBox alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar" onAction="#cerrar" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
    </HBox>
</VBox>
