<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Marco principal para el RECEPCIONISTA: menu lateral + encabezado + contenido. Sin archivo .css:
    el color/tamaño base de cada boton va inline aqui; PrincipalController aplica el resaltado al
    pasar el mouse y el color del boton seleccionado (eso no se puede fijar en el FXML porque depende
    de una accion del usuario).
    Cada boton del menu guarda en "userData" la ruta del FXML que abre. Si ese archivo
    todavia no existe (modulo pendiente), el marco muestra la pantalla "en construccion".
    Un boton "menu-grupo" despliega el VBox que le sigue (solo uno abierto a la vez).
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.PrincipalController">

    <fx:define>
        <ToggleGroup fx:id="grupoMenu"/>
    </fx:define>

    <!-- ============ MENU LATERAL ============ -->
    <left>
        <VBox spacing="6" style="-fx-background-color: #3B210F; -fx-min-width: 240px; -fx-pref-width: 240px; -fx-max-width: 240px;">
            <padding><Insets top="22" right="14" bottom="18" left="14"/></padding>

            <VBox spacing="2">
                <padding><Insets bottom="14" left="8"/></padding>
                <Label text="Hotel San Antonio" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Gestión hotelera · Bagua" style="-fx-text-fill: #E6C77A; -fx-font-size: 12px;"/>
            </VBox>

            <ScrollPane fx:id="scrollMenu" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;">
                <VBox fx:id="barraLateral" spacing="6">
                    <Label text="OPERACIÓN" style="-fx-text-fill: #D4A84C; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6px 0 0 8px;"/>
                    <ToggleButton fx:id="btnInicio" text="Inicio" toggleGroup="$grupoMenu" selected="true"
                                  userData="/untrm/hotel_san_antonio/fxml/dashboard/dashboard_2.fxml" onAction="#onMenu"/>
                    <ToggleButton text="Habitaciones" toggleGroup="$grupoMenu"
                                  userData="/untrm/hotel_san_antonio/fxml/habitaciones/habitaciones.fxml" onAction="#onMenu"/>

                    <Button text="Reservas  ▸" onAction="#onGrupo"/>
                    <VBox userData="Reservas" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Nueva reserva" toggleGroup="$grupoMenu"
                                      userData="/untrm/hotel_san_antonio/fxml/Reserva/Nueva_reserva.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Reserva programada" toggleGroup="$grupoMenu"
                                      userData="/untrm/hotel_san_antonio/fxml/Reserva/Reservas_programadas.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Calendario de ocupación" toggleGroup="$grupoMenu"
                                      userData="/untrm/hotel_san_antonio/fxml/Reserva/Calendario_ocupacion.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Confirmar reserva" toggleGroup="$grupoMenu"
                                      userData="/untrm/hotel_san_antonio/fxml/Reserva/Confirmar_reserva.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Cancelar reserva" toggleGroup="$grupoMenu"
                                      userData="/untrm/hotel_san_antonio/fxml/Reserva/Cancelar_reserva.fxml" onAction="#onMenu"/>
                    </VBox>

                    <ToggleButton text="Comprobantes" toggleGroup="$grupoMenu"
                                  userData="/untrm/hotel_san_antonio/fxml/comprobante/comprobante.fxml" onAction="#onMenu"/>
                    <ToggleButton text="Caja y pagos" toggleGroup="$grupoMenu"
                                  userData="/untrm/hotel_san_antonio/fxml/nuevos/caja/registrar_pagos.fxml" onAction="#onMenu"/>
                </VBox>
            </ScrollPane>

            <Region style="-fx-background-color: #5A3516; -fx-min-height: 1px; -fx-pref-height: 1px; -fx-max-height: 1px;"/>
            <VBox spacing="2">
                <padding><Insets top="10" bottom="8" left="8"/></padding>
                <Label fx:id="lblUsuario" text="Luis Vasquez" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="lblRol" text="Recepcionista" style="-fx-text-fill: #E6C77A; -fx-font-size: 12px;"/>
            </VBox>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #F3ECDD; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 7px 14px; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ============ ENCABEZADO + CONTENIDO (a la derecha del menu, de arriba a abajo) ============ -->
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: #3B210F;">
                    <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
                    <VBox spacing="1">
                        <Label fx:id="lblTitulo" text="Inicio" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblFecha" text="domingo, 20 de septiembre de 2026" style="-fx-font-size: 12px; -fx-text-fill: #E6C77A;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🛒  Carrito" onAction="#onCarrito"
                            style="-fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
                </HBox>
            </top>

            <!-- aqui se abre cada pantalla -->
            <center>
                <StackPane fx:id="contenido"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
