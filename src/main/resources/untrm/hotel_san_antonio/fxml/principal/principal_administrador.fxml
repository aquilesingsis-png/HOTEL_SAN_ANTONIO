<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Marco principal para el ADMINISTRADOR: acceso a todos los modulos.
    Igual que el del recepcionista (mismo controlador), pero con los modulos de administracion:
    Usuarios, Reportes y estadisticas, Almacen, y Caja completa. No incluye Huespedes.
    Cada boton guarda en "userData" la ruta del FXML que abre; si no existe, se muestra "en construccion".
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.PrincipalController">

    <stylesheets>
        <URL value="@../../css/estilos.css"/>
        <URL value="@../../css/principal.css"/>
    </stylesheets>

    <fx:define>
        <ToggleGroup fx:id="grupoMenu"/>
    </fx:define>

    <!-- ============ MENU LATERAL ============ -->
    <left>
        <VBox spacing="6" styleClass="barra-lateral">
            <padding><Insets top="22" right="14" bottom="18" left="14"/></padding>

            <VBox spacing="2">
                <padding><Insets bottom="14" left="8"/></padding>
                <Label text="Hotel San Antonio" styleClass="marca-titulo"/>
                <Label text="Gestión hotelera · Bagua" styleClass="marca-sub"/>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-menu" VBox.vgrow="ALWAYS">
                <VBox fx:id="barraLateral" spacing="6">

                    <Label text="OPERACIÓN" styleClass="menu-seccion"/>
                    <ToggleButton fx:id="btnInicio" text="Inicio" toggleGroup="$grupoMenu" selected="true" styleClass="menu-item"
                                  userData="/untrm/hotel_san_antonio/fxml/dashboard.fxml" onAction="#onMenu"/>
                    <ToggleButton text="Habitaciones" toggleGroup="$grupoMenu" styleClass="menu-item"
                                  userData="/untrm/hotel_san_antonio/fxml/habitaciones/habitaciones.fxml" onAction="#onMenu"/>

                    <Button text="Reservas  ▸" styleClass="menu-item, menu-grupo" onAction="#onGrupo"/>
                    <VBox styleClass="submenu" userData="Reservas" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Nueva reserva" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reservas/nueva_reserva.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Reserva programada" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reservas/reserva_programada.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Calendario de ocupación" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reservas/calendario_ocupacion.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Confirmar reserva" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reservas/confirmar_reserva.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Cancelar reserva" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reservas/cancelar_reserva.fxml" onAction="#onMenu"/>
                    </VBox>

                    <ToggleButton text="Comprobantes" toggleGroup="$grupoMenu" styleClass="menu-item"
                                  userData="/untrm/hotel_san_antonio/fxml/comprobante.fxml" onAction="#onMenu"/>

                    <Button text="Caja y pagos  ▸" styleClass="menu-item, menu-grupo" onAction="#onGrupo"/>
                    <VBox styleClass="submenu" userData="Caja y pagos" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Registrar pagos" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/caja/registrar_pagos.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Movimientos" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/caja/movimientos.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Totales del día" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/caja/totales_dia.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Cierre de caja" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/caja/cierre_caja.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Arqueo" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/caja/arqueo.fxml" onAction="#onMenu"/>
                    </VBox>

                    <Label text="ADMINISTRACIÓN" styleClass="menu-seccion">
                        <padding><Insets top="14" left="8"/></padding>
                    </Label>

                    <Button text="Usuarios  ▸" styleClass="menu-item, menu-grupo" onAction="#onGrupo"/>
                    <VBox styleClass="submenu" userData="Usuarios" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Crear usuario" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/usuarios/crear_usuario.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Editar / Desactivar" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/usuarios/editar_usuario.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Asignar rol" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/usuarios/asignar_rol.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Ver historial" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/usuarios/historial_usuarios.fxml" onAction="#onMenu"/>
                    </VBox>

                    <Button text="Reportes y estadísticas  ▸" styleClass="menu-item, menu-grupo" onAction="#onGrupo"/>
                    <VBox styleClass="submenu" userData="Reportes y estadísticas" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Ocupación" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reportes/ocupacion.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Ventas" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reportes/ventas.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Ingresos" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reportes/ingresos.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Reportes personalizados" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/reportes/reportes_personalizados.fxml" onAction="#onMenu"/>
                    </VBox>

                    <Button text="Almacén  ▸" styleClass="menu-item, menu-grupo" onAction="#onGrupo"/>
                    <VBox styleClass="submenu" userData="Almacén" visible="false" managed="false" spacing="2">
                        <ToggleButton text="Productos" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/almacen/productos.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Categorías" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/almacen/categorias.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Stock" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/almacen/stock.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Precios" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/almacen/precios.fxml" onAction="#onMenu"/>
                        <ToggleButton text="Alertas de stock bajo" toggleGroup="$grupoMenu" styleClass="menu-item, submenu-item"
                                      userData="/untrm/hotel_san_antonio/fxml/almacen/alertas_stock.fxml" onAction="#onMenu"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <Region styleClass="separador-menu"/>
            <VBox spacing="2">
                <padding><Insets top="10" bottom="8" left="8"/></padding>
                <Label fx:id="lblUsuario" text="Ana Torres" styleClass="usuario-nombre"/>
                <Label fx:id="lblRol" text="Administrador" styleClass="usuario-rol"/>
            </VBox>
            <Button text="Cerrar sesión" styleClass="btn-cerrar-sesion" onAction="#onCerrarSesion"/>
        </VBox>
    </left>

    <!-- ============ ENCABEZADO + CONTENIDO (a la derecha del menu, de arriba a abajo) ============ -->
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="encabezado-principal">
                    <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
                    <VBox spacing="1">
                        <Label fx:id="lblTitulo" text="Inicio" styleClass="titulo-modulo"/>
                        <Label fx:id="lblFecha" text="domingo, 20 de septiembre de 2026" styleClass="fecha-encabezado"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🛒  Carrito" styleClass="btn-carrito" onAction="#onCarrito"/>
                </HBox>
            </top>

            <!-- aqui se abre cada pantalla -->
            <center>
                <StackPane fx:id="contenido"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
