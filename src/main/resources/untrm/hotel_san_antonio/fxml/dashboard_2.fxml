<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Sin encabezado propio: el titulo de la seccion, el buscador rapido, el carrito y el
    usuario/rol ya los pone el marco principal (menu lateral + encabezado). El buscador de
    "Buscar reserva, huesped, habitacion" que traia este encabezado se quito junto con el;
    si se necesita, puede volver a ponerse dentro del contenido en vez de en un encabezado propio.
-->
<BorderPane fx:id="rootPane" prefHeight="1020.0" prefWidth="1536.0" styleClass="root-bg" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="untrm.hotel_san_antonio.controlador.DashboardController">

   <!-- ================= CENTER (contenido) ================= -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="content-scroll" BorderPane.alignment="CENTER">
         <content>
            <StackPane fx:id="centerStack">
               <children>

                  <!-- ========== VISTA: DASHBOARD ========== -->
                  <VBox fx:id="dashboardView" spacing="18.0" styleClass="dashboard-view">
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="18.0" />
                     </padding>
                     <children>

                        <!-- Saludo + fecha/hora -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="greeting-title" text="¡Hola, Administrador!" />
                                    <Label styleClass="greeting-subtitle" text="Aquí tienes un resumen de la actividad del hotel." />
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="date-card">
                                 <children>
                                    <Label styleClass="date-icon" text="📅" />
                                    <VBox>
                                       <children>
                                          <Label fx:id="lblFecha" styleClass="date-text" text="Sábado, 20 de septiembre de 2026" />
                                          <Label fx:id="lblHora" styleClass="date-hora" text="10:24 a. m." />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>

                        <!-- Tarjetas KPI -->
                        <HBox spacing="14.0" styleClass="cards-row">
                           <children>

                              <StackPane styleClass="kpi-card, kpi-green" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-green">
                                             <children><Label styleClass="kpi-icon-symbol" text="🛏" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Habitaciones ocupadas" wrapText="true" />
                                                <Label fx:id="lblOcupadas" styleClass="kpi-number" text="18" />
                                                <Label styleClass="kpi-subtitle" text="de 30 habitaciones" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 60%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                              <StackPane styleClass="kpi-card, kpi-blue" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-blue">
                                             <children><Label styleClass="kpi-icon-symbol" text="🛏" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Habitaciones disponibles" wrapText="true" />
                                                <Label fx:id="lblDisponibles" styleClass="kpi-number" text="10" />
                                                <Label styleClass="kpi-subtitle" text="de 30 habitaciones" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 33%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                              <StackPane styleClass="kpi-card, kpi-tan" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-tan">
                                             <children><Label styleClass="kpi-icon-symbol" text="👥" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Huéspedes" />
                                                <Label fx:id="lblHuespedes" styleClass="kpi-number" text="24" />
                                                <Label styleClass="kpi-subtitle" text="en el hotel" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 12%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                              <StackPane styleClass="kpi-card, kpi-red" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-red">
                                             <children><Label styleClass="kpi-icon-symbol" text="📅" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Reservas de hoy" wrapText="true" />
                                                <Label fx:id="lblReservasHoy" styleClass="kpi-number" text="5" />
                                                <Label styleClass="kpi-subtitle" text="Llegadas programadas" wrapText="true" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 25%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                              <StackPane styleClass="kpi-card, kpi-mint" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-mint">
                                             <children><Label styleClass="kpi-icon-symbol" text="💲" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Ingresos del día" wrapText="true" />
                                                <Label fx:id="lblIngresosDia" styleClass="kpi-number-sm" text="S/ 2,680.00" />
                                                <Label styleClass="kpi-subtitle" text="Habitaciones + Tienda" wrapText="true" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 18%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                              <StackPane styleClass="kpi-card, kpi-purple" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane styleClass="kpi-icon, kpi-icon-purple">
                                             <children><Label styleClass="kpi-icon-symbol" text="🛒" /></children>
                                          </StackPane>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="kpi-title" text="Ventas en tienda" wrapText="true" />
                                                <Label fx:id="lblVentasTienda" styleClass="kpi-number-sm" text="S/ 350.00" />
                                                <Label styleClass="kpi-subtitle" text="8 ventas realizadas" wrapText="true" />
                                             </children>
                                          </VBox>
                                       </children>
                                       <padding><Insets bottom="14.0" left="16.0" right="14.0" top="14.0" /></padding>
                                    </HBox>
                                    <Label styleClass="kpi-badge" text="▲ 5%" StackPane.alignment="TOP_RIGHT" />
                                 </children>
                              </StackPane>

                           </children>
                        </HBox>

                        <!-- Fila de graficos -->
                        <HBox spacing="14.0" styleClass="cards-row">
                           <children>

                              <VBox alignment="CENTER" prefWidth="330.0" spacing="6.0" styleClass="table-card">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="card-title" text="📊  Ocupación del hotel" HBox.hgrow="ALWAYS" />
                                          <Label styleClass="card-select" text="Hoy ▾" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="18.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <PieChart fx:id="chartOcupacion" labelsVisible="false" legendVisible="false" prefHeight="190.0" prefWidth="190.0" styleClass="donut-chart" />
                                                <VBox alignment="CENTER" mouseTransparent="true">
                                                   <children>
                                                      <Label fx:id="lblPorcentajeOcupacion" styleClass="donut-percent" text="60%" />
                                                      <Label styleClass="donut-percent-label" text="Ocupación actual" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </StackPane>
                                          <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-brown" text="●  Ocupadas" HBox.hgrow="ALWAYS" />
                                                   <Label fx:id="lblLeyOcupadas" styleClass="legend-value" text="18" />
                                                </children></HBox>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-beige" text="●  Disponibles" HBox.hgrow="ALWAYS" />
                                                   <Label fx:id="lblLeyDisponibles" styleClass="legend-value" text="10" />
                                                </children></HBox>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-gold" text="●  En limpieza" HBox.hgrow="ALWAYS" />
                                                   <Label fx:id="lblLeyLimpieza" styleClass="legend-value" text="2" />
                                                </children></HBox>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-gray" text="●  En mantenimiento" HBox.hgrow="ALWAYS" />
                                                   <Label fx:id="lblLeyMantenimiento" styleClass="legend-value" text="0" />
                                                </children></HBox>
                                                <Region styleClass="legend-sep" />
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-total-label" text="Total de habitaciones" HBox.hgrow="ALWAYS" />
                                                   <Label styleClass="legend-total-value" text="30" />
                                                </children></HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <VBox spacing="8.0" styleClass="table-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="card-title" text="📈  Ingresos de la semana" HBox.hgrow="ALWAYS" />
                                          <Label styleClass="card-select" text="Últimos 7 días ▾" />
                                       </children>
                                    </HBox>
                                    
                                <StackPane fx:id="contenedorGraficoIngresos" prefHeight="230.0" styleClass="income-chart" />

                                 </children>
                              </VBox>

                              <VBox alignment="CENTER" prefWidth="330.0" spacing="6.0" styleClass="table-card">
                                 <children>
                                    <Label styleClass="card-title" text="🧾  Distribución de ingresos (Hoy)" />
                                    <HBox alignment="CENTER_LEFT" spacing="18.0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <PieChart fx:id="chartDistribucion" labelsVisible="false" legendVisible="false" prefHeight="190.0" prefWidth="190.0" styleClass="donut-chart" />
                                                <VBox alignment="CENTER" mouseTransparent="true">
                                                   <children>
                                                      <Label fx:id="lblTotalIngresos" styleClass="donut-percent" text="S/ 2,680" />
                                                      <Label styleClass="donut-percent-label" text="Total" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </StackPane>
                                          <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-brown" text="●  Habitaciones" HBox.hgrow="ALWAYS" />
                                                   <Label styleClass="legend-value" text="76%" />
                                                </children></HBox>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-gold" text="●  Tienda" HBox.hgrow="ALWAYS" />
                                                   <Label styleClass="legend-value" text="13%" />
                                                </children></HBox>
                                                <HBox styleClass="legend-row"><children>
                                                   <Label styleClass="legend-dot-beige" text="●  Otros servicios" HBox.hgrow="ALWAYS" />
                                                   <Label styleClass="legend-value" text="11%" />
                                                </children></HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                           </children>
                        </HBox>

                        <!-- Fila de tablas / alertas -->
                        <HBox spacing="14.0" styleClass="cards-row">
                           <children>

                              <VBox spacing="8.0" styleClass="table-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="card-title" text="📅  Próximas llegadas (Hoy)" HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#mostrarSeccion" styleClass="link-button" text="Ver todas" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tablaLlegadas" prefHeight="210.0" styleClass="mini-table">
                                       <columns>
                                          <TableColumn fx:id="colLlegadaHora" prefWidth="55.0" text="Hora" />
                                          <TableColumn fx:id="colLlegadaHuesped" prefWidth="150.0" text="Huésped / Empresa" />
                                          <TableColumn fx:id="colLlegadaHabitacion" prefWidth="55.0" text="Hab." />
                                          <TableColumn fx:id="colLlegadaTipo" prefWidth="85.0" text="Tipo" />
                                          <TableColumn fx:id="colLlegadaEstado" prefWidth="90.0" text="Estado" />
                                       </columns>
                                    </TableView>
                                 </children>
                              </VBox>

                              <VBox spacing="8.0" styleClass="table-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="card-title" text="🔧  Habitaciones en mantenimiento" HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#mostrarSeccion" styleClass="link-button" text="Ver todas" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tablaMantenimiento" prefHeight="210.0" styleClass="mini-table">
                                       <columns>
                                          <TableColumn fx:id="colMantHabitacion" prefWidth="55.0" text="Hab." />
                                          <TableColumn fx:id="colMantTipo" prefWidth="65.0" text="Tipo" />
                                          <TableColumn fx:id="colMantMotivo" prefWidth="160.0" text="Motivo" />
                                          <TableColumn fx:id="colMantEstado" prefWidth="95.0" text="Estado" />
                                       </columns>
                                    </TableView>
                                 </children>
                              </VBox>

                              <VBox prefWidth="300.0" spacing="10.0" styleClass="table-card">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="card-title" text="🔔  Alertas y pendientes" HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#mostrarSeccion" styleClass="link-button" text="Ver todas" />
                                       </children>
                                    </HBox>
                                    <VBox fx:id="listaAlertas" spacing="4.0" />
                                 </children>
                              </VBox>

                           </children>
                        </HBox>

                        <!-- Banner inferior -->
                        <StackPane styleClass="promo-banner">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="26.0">
                                 <children>
                                    <ImageView fitHeight="135.0" fitWidth="385.0" preserveRatio="false" styleClass="promo-image">
                                       <image>
                                          <Image url="@room.jpg" />
                                       </image>
                                    </ImageView>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="promo-title" text="Brindamos más que alojamiento," wrapText="true" />
                                          <Label styleClass="promo-title-italic" text="creamos experiencias inolvidables." wrapText="true" />
                                       </children>
                                    </VBox>
                                    <Region styleClass="promo-divider" />
                                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                                       <children>
                                          <Label styleClass="promo-hotel-name" text="Hotel San Antonio" />
                                          <Label styleClass="promo-hotel-sub" text="Tu comodidad, nuestra prioridad" />
                                       </children>
                                    </VBox>
                                 </children>
                                 <padding>
                                    <Insets bottom="20.0" left="20.0" right="34.0" top="20.0" />
                                 </padding>
                              </HBox>
                           </children>
                        </StackPane>

                     </children>
                  </VBox>

                  <!-- ========== VISTA: PLACEHOLDER (otras secciones) ========== -->
                  <VBox fx:id="placeholderView" alignment="CENTER" spacing="10.0" styleClass="placeholder-view" visible="false">
                     <children>
                        <Label fx:id="lblPlaceholderTitulo" styleClass="placeholder-title" text="Sección" />
                        <Label styleClass="placeholder-text" text="Este módulo está en construcción." />
                        <Button mnemonicParsing="false" onAction="#mostrarDashboard" styleClass="primary-button" text="Volver al Dashboard" />
                     </children>
                  </VBox>

               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
