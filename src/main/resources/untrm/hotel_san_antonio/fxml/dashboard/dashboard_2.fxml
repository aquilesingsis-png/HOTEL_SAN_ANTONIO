<!--
    Sin encabezado propio: el titulo de la seccion, el buscador rapido, el carrito y el
    usuario/rol ya los pone el marco principal (menu lateral + encabezado). El buscador de
    "Buscar reserva, huesped, habitacion" que traia este encabezado se quito junto con el;
    si se necesita, puede volver a ponerse dentro del contenido en vez de en un encabezado propio.
    Sin archivo .css: todo el estilo es inline. Lo que una hoja de estilos alcanza pero un
    style="" no (el interior del ScrollPane, el encabezado y las filas de las mini-tablas)
    lo resuelve DashboardController con setStyle() apenas cada control arma su piel.
-->
<BorderPane fx:id="rootPane" prefHeight="1020.0" prefWidth="1536.0"
            style="-fx-background-color: #F3EFE7; -fx-font-family: 'Segoe UI';"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.DashboardController">

