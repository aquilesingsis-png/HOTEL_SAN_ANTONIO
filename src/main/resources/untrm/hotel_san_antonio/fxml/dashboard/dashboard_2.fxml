                                          <TableColumn fx:id="colMantMotivo" prefWidth="160.0" text="Motivo" />
                                          <TableColumn fx:id="colMantEstado" prefWidth="95.0" text="Estado" />
                                       </columns>
                                    </TableView>
                                 </children>
                              </VBox>

                              <VBox prefWidth="300.0" spacing="10.0"
                                    style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label text="🔔  Alertas y pendientes" style="-fx-font-size: 13.5px; -fx-font-weight: bold; -fx-text-fill: #2C2118;" HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#mostrarSeccion" text="Ver todas"
                                                  style="-fx-background-color: #F5E6C8; -fx-text-fill: #8A5A1E; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 5 12 5 12; -fx-cursor: hand;" />
                                       </children>
                                    </HBox>
                                    <VBox fx:id="listaAlertas" spacing="4.0" />
                                 </children>
                              </VBox>

                           </children>
                        </HBox>

                     </children>
                  </VBox>

                  <!-- ========== VISTA: PLACEHOLDER (otras secciones) ========== -->
                  <VBox fx:id="placeholderView" alignment="CENTER" spacing="10.0" visible="false"
                        style="-fx-background-color: #F3EFE7; -fx-min-height: 500px;">
                     <children>
                        <Label fx:id="lblPlaceholderTitulo" text="Sección" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C2118;" />
                        <Label text="Este módulo está en construcción." style="-fx-font-size: 13px; -fx-text-fill: #8A7F70;" />
                        <Button mnemonicParsing="false" onAction="#mostrarDashboard" text="Volver al Dashboard"
                                style="-fx-background-color: #B8863F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 22 10 22; -fx-cursor: hand;" />
                     </children>
                  </VBox>

               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
