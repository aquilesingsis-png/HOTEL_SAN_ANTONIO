<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="untrm.hotel_san_antonio.controlador.CategoriasHabitacionController"
    spacing="14" style="-fx-background-color: #F7F4EF; -fx-padding: 24;">
    <Label text="Configure el nivel comercial de cada tipo con el hotel. Un número mayor representa una categoría superior. La capacidad se valida por separado. Sin nivel configurado solo se permiten cambios al mismo tipo." wrapText="true"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefHeight="360" style="-fx-background-color: white; -fx-border-color: #E8E2D9;">
        <columns>
            <TableColumn fx:id="colNombre" text="Tipo" prefWidth="200"/>
            <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="120"/>
            <TableColumn fx:id="colPrecio" text="Tarifa S/" prefWidth="120"/>
            <TableColumn fx:id="colNivel" text="Nivel" prefWidth="160"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Label text="Nivel de la selección:"/>
        <Spinner fx:id="spNivel" prefWidth="100" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
        <Button fx:id="btnGuardar" text="Guardar nivel" onAction="#guardar" disable="true" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        <Button text="Actualizar" onAction="#actualizar" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
    </HBox>
    <Label fx:id="lblEstado" wrapText="true"/>
</VBox>
