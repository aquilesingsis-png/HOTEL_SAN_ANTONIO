<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: cuenta de una habitacion ocupada (cargos, pagos, saldo y check-out). Sin archivo .css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.CuentaHabitacionController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #3B210F;">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="lblTitulo" text="Cuenta · Habitación 207" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstadia" text="Ingreso 19/09/2026  ·  Salida 21/09/2026"
                   style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;">
            <VBox spacing="16">
                <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                <!-- ============ HUESPED + SALDO ============ -->
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Huésped" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <Label fx:id="lblHuesped" text="Nombre del huésped" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <HBox spacing="30">
                            <VBox spacing="2">
                                <Label text="Documento" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <Label fx:id="lblDocumento" text="DNI 00000000"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Teléfono" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <Label fx:id="lblTelefono" text="900000000"/>
                            </VBox>
                        </HBox>
                        <VBox fx:id="boxEmpresa" spacing="2">
                            <Label text="Factura a la empresa" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <Label fx:id="lblEmpresa" text="Razón social (RUC 00000000000)"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Ampliar estadía" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Noches a agregar" minWidth="-Infinity"/>
                                <Spinner fx:id="spnNoches" min="1" max="30" initialValue="1" prefWidth="80" minWidth="80"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnAmpliar" text="Ampliar estadía" minWidth="-Infinity" onAction="#onAmpliar"
                                        style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
                            </HBox>
                            <Label fx:id="lblNuevaSalida" text="Nueva salida: 22/09/2026 · + S/ 65.00" style="-fx-text-fill: #777777;" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="8" minWidth="300" prefWidth="300" maxWidth="300"
                          style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Saldo" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <HBox>
                            <Label text="Total de la cuenta" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalCuenta" text="S/ 0.00"/>
                        </HBox>
                        <HBox>
                            <Label text="Total pagado" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalPagos" text="S/ 0.00"/>
                        </HBox>
                        <Label text="Saldo pendiente" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                        <Label fx:id="lblSaldo" text="S/ 0.00" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- ============ CARGOS ============ -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                    <Label text="Cargos de la cuenta" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                    <TableView fx:id="tblCargos" prefHeight="190" minHeight="120">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Sin cargos"/></placeholder>
                        <columns>
                            <TableColumn text="Fecha inicio" minWidth="95" maxWidth="115">
                                <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Fecha fin" minWidth="95" maxWidth="115">
                                <cellValueFactory><PropertyValueFactory property="fechaFin"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Área" minWidth="90" maxWidth="110">
                                <cellValueFactory><PropertyValueFactory property="area"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Detalle" minWidth="160">
                                <cellValueFactory><PropertyValueFactory property="detalle"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Cant." minWidth="50" maxWidth="70" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="cantidad"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Precio (S/)" minWidth="80" maxWidth="110" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="precio"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Subtotal (S/)" minWidth="90" maxWidth="120" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="subtotal"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- ============ PAGOS + REGISTRAR PAGO ============ -->
                <HBox spacing="16">
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Pagos realizados" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <TableView fx:id="tblPagos" prefHeight="150" minHeight="110">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="Sin pagos"/></placeholder>
                            <columns>
                                <TableColumn text="Fecha" minWidth="90">
                                    <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Detalle" minWidth="80">
                                    <cellValueFactory><PropertyValueFactory property="detalle"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Método" minWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="metodo"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Monto (S/)" minWidth="90" style="-fx-alignment: CENTER_RIGHT;">
                                    <cellValueFactory><PropertyValueFactory property="monto"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="10" minWidth="300" prefWidth="300" maxWidth="300"
                          style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Registrar pago" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <VBox spacing="4">
                            <Label text="Monto (S/)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <TextField fx:id="txtMonto"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Método de pago" fx:id="lblMetodo1" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                            <ComboBox fx:id="cmbMetodo" maxWidth="Infinity">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Efectivo"/>
                                        <String fx:value="Yape"/>
                                        <String fx:value="Transferencia"/>
                                        <String fx:value="Tarjeta"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>
                        <CheckBox fx:id="chkDividirPago" text="Dividir en dos métodos"/>
                        <VBox fx:id="boxSegundoPago" spacing="10">
                            <VBox spacing="4">
                                <Label text="Segundo método" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <ComboBox fx:id="cmbMetodo2" maxWidth="Infinity">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Efectivo"/>
                                            <String fx:value="Yape"/>
                                            <String fx:value="Transferencia"/>
                                            <String fx:value="Tarjeta"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Monto con el segundo método (S/)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtMonto2"/>
                            </VBox>
                            <Label fx:id="lblDivision" style="-fx-text-fill: #777777;" wrapText="true"/>
                        </VBox>
                        <Button fx:id="btnRegistrarPago" text="Registrar pago" maxWidth="Infinity" onAction="#onRegistrarPago"
                                style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #E5E5E5; -fx-border-width: 1px 0 0 0;">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="lblAviso" text="Cobra el saldo pendiente para poder hacer el check-out."
                   style="-fx-text-fill: #777777;" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#onCerrar"
                    style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
            <Button fx:id="btnCheckOut" text="Check-Out" onAction="#onCheckOut"
                    style="-fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>
