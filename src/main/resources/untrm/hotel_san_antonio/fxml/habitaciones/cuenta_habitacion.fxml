<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: cuenta de una habitacion ocupada (cargos, pagos, saldo y check-out). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.CuentaHabitacionController">

    <stylesheets>
        <URL value="@../../css/estilos.css"/>
        <URL value="@../../css/habitaciones.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel-encabezado">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="lblTitulo" text="Cuenta · Habitación 207" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstadia" text="Ingreso 19/09/2026  ·  Salida 21/09/2026"
                   style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-transparente">
            <VBox spacing="16">
                <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                <!-- ============ HUESPED + SALDO ============ -->
                <HBox spacing="16">
                    <VBox spacing="8" styleClass="panel-form" HBox.hgrow="ALWAYS">
                        <Label text="Huésped" styleClass="titulo-panel"/>
                        <Label fx:id="lblHuesped" text="Nombre del huésped" styleClass="valor-grande"/>
                        <HBox spacing="30">
                            <VBox spacing="2">
                                <Label text="Documento" styleClass="etiqueta-form"/>
                                <Label fx:id="lblDocumento" text="DNI 00000000"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Teléfono" styleClass="etiqueta-form"/>
                                <Label fx:id="lblTelefono" text="900000000"/>
                            </VBox>
                        </HBox>
                        <VBox fx:id="boxEmpresa" spacing="2">
                            <Label text="Factura a la empresa" styleClass="etiqueta-form"/>
                            <Label fx:id="lblEmpresa" text="Razón social (RUC 00000000000)"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Ampliar estadía" styleClass="etiqueta-form"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Noches a agregar" minWidth="-Infinity"/>
                                <Spinner fx:id="spnNoches" min="1" max="30" initialValue="1" prefWidth="80" minWidth="80"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnAmpliar" text="Ampliar estadía" styleClass="btn-secundario" minWidth="-Infinity" onAction="#onAmpliar"/>
                            </HBox>
                            <Label fx:id="lblNuevaSalida" text="Nueva salida: 22/09/2026 · + S/ 65.00" styleClass="texto-secundario" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="8" styleClass="panel-form" minWidth="300" prefWidth="300" maxWidth="300">
                        <Label text="Saldo" styleClass="titulo-panel"/>
                        <HBox>
                            <Label text="Total de la cuenta" styleClass="etiqueta-form"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalCuenta" text="S/ 0.00"/>
                        </HBox>
                        <HBox>
                            <Label text="Total pagado" styleClass="etiqueta-form"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalPagos" text="S/ 0.00"/>
                        </HBox>
                        <Label text="Saldo pendiente" styleClass="etiqueta-form"/>
                        <Label fx:id="lblSaldo" text="S/ 0.00" styleClass="valor-grande"/>
                    </VBox>
                </HBox>

                <!-- ============ CARGOS ============ -->
                <VBox spacing="10" styleClass="panel-form">
                    <Label text="Cargos de la cuenta" styleClass="titulo-panel"/>
                    <TableView fx:id="tblCargos" styleClass="tabla-cuenta" prefHeight="190" minHeight="120">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Sin cargos"/></placeholder>
                        <columns>
                            <TableColumn text="Fecha inicio" minWidth="95" maxWidth="115">
                                <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Fecha fin" minWidth="95" maxWidth="115">
                                <cellValueFactory><PropertyValueFactory property="fechaFin"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Área" minWidth="90" maxWidth="110">
                                <cellValueFactory><PropertyValueFactory property="area"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Detalle" minWidth="160">
                                <cellValueFactory><PropertyValueFactory property="detalle"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Cant." minWidth="50" maxWidth="70" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="cantidad"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Precio (S/)" minWidth="80" maxWidth="110" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="precio"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Subtotal (S/)" minWidth="90" maxWidth="120" style="-fx-alignment: CENTER_RIGHT;">
                                <cellValueFactory><PropertyValueFactory property="subtotal"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- ============ PAGOS + REGISTRAR PAGO ============ -->
                <HBox spacing="16">
                    <VBox spacing="10" styleClass="panel-form" HBox.hgrow="ALWAYS">
                        <Label text="Pagos realizados" styleClass="titulo-panel"/>
                        <TableView fx:id="tblPagos" styleClass="tabla-cuenta" prefHeight="150" minHeight="110">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="Sin pagos"/></placeholder>
                            <columns>
                                <TableColumn text="Fecha" minWidth="90">
                                    <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Detalle" minWidth="80">
                                    <cellValueFactory><PropertyValueFactory property="detalle"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Método" minWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="metodo"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Monto (S/)" minWidth="90" style="-fx-alignment: CENTER_RIGHT;">
                                    <cellValueFactory><PropertyValueFactory property="monto"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="10" styleClass="panel-form" minWidth="300" prefWidth="300" maxWidth="300">
                        <Label text="Registrar pago" styleClass="titulo-panel"/>
                        <VBox spacing="4">
                            <Label text="Monto (S/)" styleClass="etiqueta-form"/>
                            <TextField fx:id="txtMonto"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Método de pago" fx:id="lblMetodo1" styleClass="etiqueta-form"/>
                            <ComboBox fx:id="cmbMetodo" maxWidth="Infinity">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Efectivo"/>
                                        <String fx:value="Yape"/>
                                        <String fx:value="Transferencia"/>
                                        <String fx:value="Tarjeta"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>
                        <CheckBox fx:id="chkDividirPago" text="Dividir en dos métodos"/>
                        <VBox fx:id="boxSegundoPago" spacing="10">
                            <VBox spacing="4">
                                <Label text="Segundo método" styleClass="etiqueta-form"/>
                                <ComboBox fx:id="cmbMetodo2" maxWidth="Infinity">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Efectivo"/>
                                            <String fx:value="Yape"/>
                                            <String fx:value="Transferencia"/>
                                            <String fx:value="Tarjeta"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Monto con el segundo método (S/)" styleClass="etiqueta-form"/>
                                <TextField fx:id="txtMonto2"/>
                            </VBox>
                            <Label fx:id="lblDivision" styleClass="texto-secundario" wrapText="true"/>
                        </VBox>
                        <Button fx:id="btnRegistrarPago" text="Registrar pago" styleClass="btn-secundario"
                                maxWidth="Infinity" onAction="#onRegistrarPago"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="panel-pie">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="lblAviso" text="Cobra el saldo pendiente para poder hacer el check-out."
                   styleClass="texto-secundario" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCerrar" text="Cerrar" styleClass="btn-secundario" onAction="#onCerrar"/>
            <Button fx:id="btnCheckOut" text="Check-Out" styleClass="btn-primario" onAction="#onCheckOut"/>
        </HBox>
    </bottom>
</BorderPane>
