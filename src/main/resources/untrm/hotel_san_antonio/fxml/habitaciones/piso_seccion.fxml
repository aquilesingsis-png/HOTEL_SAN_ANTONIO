<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Un piso: titulo + tarjetas de sus habitaciones. La tarjeta incluida es de muestra
    (para verla en Scene Builder); el controlador la reemplaza con las reales. Sin archivo .css.
-->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.PisoSeccionController"
      spacing="10">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="lblTitulo" text="Piso 1" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
        <Label fx:id="lblCantidad" text="8 habitaciones" style="-fx-text-fill: #777777;"/>
    </HBox>

    <FlowPane fx:id="tarjetas" hgap="14" vgap="14">
        <fx:include source="tarjeta_habitacion.fxml"/>
    </FlowPane>
</VBox>
