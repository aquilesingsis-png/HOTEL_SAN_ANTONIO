<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: registrar huesped y reserva desde una habitacion disponible. Sin archivo .css: todo el estilo es inline. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.ReservaFormController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #3B210F;">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Label fx:id="lblTitulo" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstadoHab" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollForm" fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;">
            <HBox spacing="20" alignment="TOP_LEFT">
                <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                <!-- ============ FORMULARIO ============ -->
                <VBox spacing="16" HBox.hgrow="ALWAYS">

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Huésped" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <GridPane hgap="14" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Tipo de documento" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <ComboBox fx:id="cmbTipoDoc" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Número de documento" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="txtDocumento" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnBuscarDoc" text="Buscar"
                                            style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"
                                            onAction="#onBuscarDocumento"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Nombres" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtNombres"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Apellidos" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtApellidos"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label text="País de procedencia" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtPais"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label text="Teléfono (opcional)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtTelefono" promptText="9XXXXXXXX"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                <Label text="Correo electrónico (opcional)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtEmail"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Estadía" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <GridPane hgap="14" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Fecha de ingreso" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <DatePicker fx:id="dpIngreso" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Fecha de salida" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <DatePicker fx:id="dpSalida" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Canal de reserva" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <ComboBox fx:id="cmbCanal" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Noches" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <Label fx:id="lblNoches" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B2B2B; -fx-padding: 6px 0 0 0;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label fx:id="lblTituloPago" text="Adelanto" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <GridPane hgap="14" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label fx:id="lblMontoPago" text="Monto del adelanto (S/)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtAdelanto"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="lblMetodo1" text="Método de pago" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <ComboBox fx:id="cmbMetodo" maxWidth="Infinity"/>
                            </VBox>
                        </GridPane>

                        <CheckBox fx:id="chkDividirPago" text="Dividir el pago en dos métodos"/>
                        <GridPane fx:id="boxSegundoPago" hgap="14" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Segundo método" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <ComboBox fx:id="cmbMetodo2" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Monto con el segundo método (S/)" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtMonto2"/>
                            </VBox>
                            <Label fx:id="lblDivision" style="-fx-text-fill: #777777;" wrapText="true"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <CheckBox fx:id="chkEmpresa" text="Facturar a una empresa"/>
                        <VBox fx:id="boxEmpresa" spacing="12">
                            <VBox spacing="4">
                                <Label text="RUC" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="txtRuc" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnBuscarRuc" text="Buscar"
                                            style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"
                                            onAction="#onBuscarRuc"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Razón social" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtRazonSocial"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Dirección fiscal" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                                <TextField fx:id="txtDireccionFiscal"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ============ PANEL LATERAL ============ -->
                <VBox spacing="16" minWidth="300" prefWidth="300" maxWidth="300">
                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="La habitación" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <Label fx:id="lblHabNumero" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <Label fx:id="lblHabTipo" style="-fx-text-fill: #777777;"/>
                        <Label fx:id="lblHabCapacidad"/>
                        <Label fx:id="lblHabTarifa"/>
                        <Label text="Incluye" style="-fx-font-size: 12px; -fx-text-fill: #777777;"/>
                        <Label fx:id="lblHabIncluye" wrapText="true" style="-fx-text-fill: #777777;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E5E5E5; -fx-border-radius: 8px; -fx-padding: 16px;">
                        <Label text="Resumen" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <Label fx:id="lblResCalculo" style="-fx-text-fill: #777777;"/>
                        <Label fx:id="lblResTotal" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <Label fx:id="lblResMinimo"/>
                        <Label fx:id="lblResSaldo"/>
                    </VBox>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #E5E5E5; -fx-border-width: 1px 0 0 0;">
            <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
            <Button fx:id="btnMantenimiento" text="Poner en mantenimiento"
                    style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"
                    onAction="#onMantenimiento"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelar" text="Cancelar"
                    style="-fx-background-color: transparent; -fx-text-fill: #3B210F; -fx-border-color: #5A3516; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"
                    onAction="#onCancelar"/>
            <Button fx:id="btnGuardar" text="Registrar check-in"
                    style="-fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 8px 20px; -fx-cursor: hand;"
                    onAction="#onGuardar"/>
        </HBox>
    </bottom>
</BorderPane>
