<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="untrm.hotel_san_antonio.controlador.LimpiezaController"
    spacing="14" style="-fx-background-color: #F7F4EF; -fx-padding: 24;">
    <Label text="Seleccione una habitación disponible o en limpieza. Las ocupadas y en mantenimiento no se pueden cambiar aquí." wrapText="true"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #E8E2D9;">
        <columns>
            <TableColumn fx:id="colNumero" text="Habitación" prefWidth="140"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="180"/>
            <TableColumn fx:id="colPiso" text="Piso" prefWidth="90"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="160"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="Actualizar" onAction="#actualizar" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        <Button fx:id="btnPendiente" text="Marcar en limpieza" onAction="#marcarEnLimpieza" disable="true" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        <Button fx:id="btnLista" text="Marcar disponible" onAction="#marcarDisponible" disable="true" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
    </HBox>
    <Label fx:id="lblMensaje" wrapText="true"/>
</VBox>
