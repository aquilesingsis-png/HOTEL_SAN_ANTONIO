<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.Reserva.HuespedAdicionalController"
      spacing="6" styleClass="acompanante" stylesheets="@reserva.css">
    <Label fx:id="lblTitulo" text="Acompañante" styleClass="acompanante-titulo"/>
    <HBox spacing="8">
        <TextField fx:id="txtDni" promptText="DNI (8 dígitos)" prefWidth="145" onAction="#buscar"/>
        <Button text="Buscar DNI" onAction="#buscar"/>
        <Label fx:id="lblEstado" text="" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="8">
        <TextField fx:id="txtNombres" promptText="Nombres *" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtApellidos" promptText="Apellidos *" HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
