<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.Reserva.CancelarReservaController"
            prefWidth="1100"
            prefHeight="720"
            style="-fx-background-color: #F7F8FA;">


    <!-- HEADER -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="72"
              style="-fx-background-color: white;">

            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <!-- Sin icono ni titulo propio: el marco principal ya los pone; se deja el buscador. -->
            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscarReserva"
                       promptText="Buscar reserva por código, nombre o DNI..."
                       prefWidth="280"
                       minWidth="170"
                       prefHeight="36"
                       style="-fx-border-color: #E3E3E3;
                              -fx-background-radius: 18;
                              -fx-border-radius: 18;"/>

            <Button text="Buscar"
                    onAction="#buscarReserva"
                    prefHeight="35"
                    style="-fx-background-color: #A56D17;
                           -fx-text-fill: white;"/>

        </HBox>

    </top>


    <center>

        <GridPane hgap="15">

            <padding>
                <Insets top="18"
                        right="20"
                        bottom="18"
                        left="20"/>
            </padding>

            <columnConstraints>

                <ColumnConstraints percentWidth="62"/>

                <ColumnConstraints percentWidth="38"/>

            </columnConstraints>


            <!-- DATOS -->

            <VBox GridPane.columnIndex="0"
                  spacing="13"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #E5E5E5;
                         -fx-border-radius: 10;
                         -fx-padding: 17;">

                <HBox alignment="CENTER_LEFT">

                    <Label text="Información de la reserva"
                           style="-fx-font-size: 19px;
                                  -fx-font-weight: bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblEstado"
                           text="Sin reserva seleccionada"
                           style="-fx-background-color: #F0F0F0;
                                  -fx-background-radius: 14;
                                  -fx-padding: 6 12;"/>

                </HBox>


                <Region prefHeight="1"
                        style="-fx-background-color: #EEEEEE;"/>


                <HBox spacing="18">

                    <StackPane prefWidth="190"
                               minWidth="160"
                               prefHeight="180"
                               style="-fx-background-color: #F0F0F0;
                                      -fx-background-radius: 10;">

                        <Label text="Imagen habitación"
                               style="-fx-text-fill: #AAAAAA;"/>

                    </StackPane>


                    <VBox spacing="11"
                          HBox.hgrow="ALWAYS">

                        <HBox>
                            <Label text="Código de reserva"
                                   prefWidth="130"/>
                            <Label fx:id="lblCodigo"
                                   text="--"
                                   style="-fx-font-weight: bold;"/>
                        </HBox>

                        <HBox>
                            <Label text="Huésped / Empresa"
                                   prefWidth="130"/>
                            <Label fx:id="lblCliente"
                                   text="--"/>
                        </HBox>

                        <HBox>
                            <Label text="DNI / RUC"
                                   prefWidth="130"/>
                            <Label fx:id="lblDocumento"
                                   text="--"/>
                        </HBox>

                        <HBox>
                            <Label text="Teléfono"
                                   prefWidth="130"/>
                            <Label fx:id="lblTelefono"
                                   text="--"/>
                        </HBox>

                        <HBox>
                            <Label text="Correo"
                                   prefWidth="130"/>
                            <Label fx:id="lblCorreo"
                                   text="--"/>
                        </HBox>

                    </VBox>

                </HBox>


                <HBox spacing="15">

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Ingreso"/>
                        <Label fx:id="lblIngreso"
                               text="--"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Salida"/>
                        <Label fx:id="lblSalida"
                               text="--"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Noches"/>
                        <Label fx:id="lblNoches"
                               text="--"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                </HBox>


                <HBox spacing="15">

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Habitación"/>
                        <Label fx:id="lblHabitacion"
                               text="--"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Huéspedes"/>
                        <Label fx:id="lblHuespedes"
                               text="--"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Total estimado"/>
                        <Label fx:id="lblTotal"
                               text="S/ 0.00"
                               style="-fx-font-weight: bold;"/>
                    </VBox>

                </HBox>


                <Label text="Observaciones"
                       style="-fx-font-weight: bold;"/>

                <TextArea fx:id="txtObservaciones"
                          editable="false"
                          promptText="Sin observaciones"
                          prefHeight="75"/>

            </VBox>


            <!-- MOTIVO -->

            <VBox GridPane.columnIndex="1"
                  spacing="13"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #E5E5E5;
                         -fx-border-radius: 10;
                         -fx-padding: 17;">

                <Label text="Motivo de cancelación"
                       style="-fx-font-size: 19px;
                              -fx-font-weight: bold;"/>

                <Label text="Seleccione un motivo"/>

                <ChoiceBox fx:id="cbMotivo"
                           maxWidth="Infinity"/>

                <Label text="Detalle (opcional)"/>

                <TextArea fx:id="txtDetalle"
                          promptText="Detalle de la cancelación..."
                          prefHeight="120"
                          wrapText="true"/>

                <CheckBox fx:id="chkNotificar"
                          text="Notificar al cliente por correo"/>

                <VBox style="-fx-background-color: #FFE8E8;
                             -fx-background-radius: 8;
                             -fx-padding: 13;">

                    <Label text="Al cancelar, la habitación quedará nuevamente disponible en el calendario."
                           wrapText="true"
                           style="-fx-text-fill: #A02929;"/>

                </VBox>

                <Region VBox.vgrow="ALWAYS"/>


                <HBox spacing="8">

                    <Button text="←  Volver"
                            onAction="#volver"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="45"/>

                    <Button text="Cancelar reserva"
                            onAction="#cancelarReserva"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="45"
                            style="-fx-background-color: #EF2929;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 7;"/>

                </HBox>

            </VBox>

        </GridPane>

    </center>

</BorderPane>