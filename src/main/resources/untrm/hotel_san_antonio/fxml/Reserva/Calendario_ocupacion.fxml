<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Vista "Calendario" de la pantalla Reservas (Reservas.fxml): solo muestra la ocupacion.
     Para reservar se usa "Nueva reserva"; al hacer clic en una reserva se abre su detalle. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.Reserva.CalendarioOcupacionController"
      spacing="12">
    <fx:define><ToggleGroup fx:id="grupoVista"/></fx:define>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ChoiceBox fx:id="cbPiso" prefWidth="170" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="btnSemana" text="Semana" toggleGroup="$grupoVista" selected="true" onAction="#cambiarVista"/>
        <ToggleButton fx:id="btnMes" text="Mes completo" toggleGroup="$grupoVista" onAction="#cambiarVista"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Button text="‹" onAction="#periodoAnterior" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
        <Label fx:id="lblPeriodo" text="Periodo" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
        <Button text="›" onAction="#periodoSiguiente" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
    </HBox>
    <HBox spacing="14">
        <Label text="● Libre" style="-fx-text-fill: #2CB95F;"/>
        <Label text="● Confirmada" style="-fx-text-fill: #2E88DD;"/>
        <Label text="● Check-in" style="-fx-text-fill: #EF4141;"/>
        <Label text="● Limpieza" style="-fx-text-fill: #C99925;"/>
        <Label text="● Mantenimiento" style="-fx-text-fill: #8F887F;"/>
        <Label fx:id="lblAyuda" text="Haz clic en una reserva para ver su detalle" style="-fx-text-fill: #6A625A;"/>
    </HBox>
    <ScrollPane fitToHeight="true" pannable="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: white; -fx-background-radius: 8;">
        <content>
            <VBox spacing="0" style="-fx-background-color: white;">
                <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-background-color: #F1ECE4; -fx-padding: 6 0;">
                    <Label text="Habitación" minWidth="150" prefWidth="150" maxWidth="150" style="-fx-font-weight: bold;"/>
                    <HBox fx:id="contenedorCabeceraDias" spacing="5"/>
                </HBox>
                <VBox fx:id="contenedorHabitaciones" spacing="0">
                    <Label fx:id="lblSinHabitaciones" text="Cargando calendario..." style="-fx-padding: 20;"/>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
