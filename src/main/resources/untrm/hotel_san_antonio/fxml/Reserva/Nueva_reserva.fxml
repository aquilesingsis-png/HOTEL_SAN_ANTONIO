<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.Reserva.Nueva_reservaController"
            fitToWidth="true" stylesheets="@reserva.css" style="-fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-background-color: #F7F4EF;">
            <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
            <Label text="Nueva reserva" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #2C2118;"/>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="1. Huésped y facturación" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <ToggleButton fx:id="btnPersonaNatural" text="Persona natural" selected="true"/>
                    <ToggleButton fx:id="btnEmpresa" text="Empresa"/>
                </HBox>
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" prefWidth="220"/>
                        <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label fx:id="lblTipoDocumento" text="DNI del huésped *"/>
                        <TextField fx:id="txtDocumento" onAction="#buscarCliente"/>
                    </VBox>
                    <VBox fx:id="filaDocumentoHuesped" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="DNI de la persona que se hospedará *"/>
                        <TextField fx:id="txtDocumentoHuesped" promptText="8 dígitos" onAction="#buscarCliente"/>
                    </VBox>
                </GridPane>
                <Button fx:id="btnBuscarCliente" text="Buscar local / autocompletar" onAction="#buscarCliente"
                        style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="lblEstadoBusqueda" wrapText="true" style="-fx-text-fill: #655C54;"/>

                <VBox fx:id="panelDatosEmpresa" spacing="8" visible="false" managed="false"
                      style="-fx-background-color: #F8F5F0; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text="Datos de empresa" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtRazonSocial" promptText="Razón social *" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtDireccionFiscal" promptText="Dirección fiscal" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox fx:id="panelDatosHuesped" spacing="8" visible="false" managed="false"
                      style="-fx-background-color: #F8F5F0; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text="Datos del huésped" style="-fx-font-weight: bold;"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <TextField fx:id="txtNombres" promptText="Nombres *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtApellidos" promptText="Apellidos *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtPais" promptText="País *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtCorreo" promptText="Correo" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                    </GridPane>
                </VBox>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="2. Fechas y ocupación" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox spacing="14">
                    <VBox spacing="4"><Label text="Ingreso *"/><DatePicker fx:id="dpFechaIngreso"/></VBox>
                    <VBox spacing="4"><Label text="Salida *"/><DatePicker fx:id="dpFechaSalida"/></VBox>
                    <VBox spacing="4"><Label text="Hora de llegada"/><ChoiceBox fx:id="cbHoraIngreso" prefWidth="120"/></VBox>
                    <VBox spacing="4"><Label text="Huéspedes *"/><Spinner fx:id="spHuespedes" prefWidth="100"/></VBox>
                    <VBox spacing="4"><Label text="Noches"/><Label fx:id="lblNoches" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold;"/></VBox>
                </HBox>
                <VBox fx:id="contenedorAcompanantes" spacing="8" visible="false" managed="false"/>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="3. Plano de habitaciones" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <ChoiceBox fx:id="cbPiso" prefWidth="180"/>
                    <ChoiceBox fx:id="cbTipoHabitacion" prefWidth="220"/>
                </HBox>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="● Disponible en las fechas" style="-fx-text-fill: #27643B;"/>
                    <Label text="● No disponible" style="-fx-text-fill: #8A7C6A;"/>
                    <Label text="● Seleccionada" style="-fx-text-fill: #704313;"/>
                </HBox>
                <Label text="Selecciona una habitación del plano. El pasillo separa las dos alas del piso."
                       style="-fx-text-fill: #655C54;" wrapText="true"/>
                <VBox fx:id="contenedorHabitaciones" spacing="8">
                    <!-- Vista de ejemplo visible y editable en Scene Builder. En ejecución se sustituyen
                         estas habitaciones por las de MySQL para las fechas seleccionadas. -->
                    <Label fx:id="lblSinHabitaciones" text="Vista de referencia del plano · cargando disponibilidad"/>
                    <VBox spacing="8" styleClass="plano-piso">
                        <Label text="Piso 1 · Ala norte y ala sur" styleClass="plano-titulo"/>
                        <GridPane hgap="8" vgap="8">
                            <Button text="101&#10;Simple" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Button text="102&#10;Doble" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Button text="103&#10;Simple" disable="true" styleClass="plano-habitacion,plano-habitacion-ocupada" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <Button text="104&#10;Matrimonial" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <Label text="PASILLO CENTRAL  ·  ACCESO A HABITACIONES" styleClass="plano-pasillo"
                                   maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="4"/>
                            <Button text="105&#10;Doble" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Button text="106&#10;Simple" disable="true" styleClass="plano-habitacion,plano-habitacion-ocupada" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Button text="107&#10;Triple" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <Button text="108&#10;Doble" disable="true" styleClass="plano-habitacion,plano-habitacion-disponible" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="4. Resumen y pago" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <GridPane hgap="18" vgap="8">
                    <Label text="Habitación" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblHabitacionResumen" text="--" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Noches" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblNochesResumen" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Precio por noche" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label fx:id="lblPrecioNoche" text="S/ 0.00" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Total" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Label fx:id="lblTotal" text="S/ 0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #A87425;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                </GridPane>
                <Label fx:id="lblAyudaPago" wrapText="true" style="-fx-text-fill: #655C54;"/>
                <HBox spacing="10">
                    <ChoiceBox fx:id="cbMetodoPago" prefWidth="180"/>
                    <TextField fx:id="txtMontoPago" promptText="Monto a pagar" prefWidth="160"/>
                </HBox>
            </VBox>

            <HBox spacing="10">
                <Button text="Limpiar" onAction="#cancelarFormulario"/>
                <Button text="Guardar pendiente" onAction="#guardarPendiente"
                        style="-fx-background-color: #C98A1B; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Confirmar con pago" onAction="#confirmarReserva"
                        style="-fx-background-color: #2E88DD; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
