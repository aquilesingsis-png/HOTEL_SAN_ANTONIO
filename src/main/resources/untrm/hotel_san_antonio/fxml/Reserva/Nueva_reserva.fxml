<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.Reserva.Nueva_reservaController"
            fitToWidth="true" style="-fx-background-color: transparent;">
    <content>
        <VBox spacing="16" style="-fx-background-color: #F7F4EF;">
            <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
            <Label text="Nueva reserva" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #2C2118;"/>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="1. Huésped y facturación" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <CheckBox fx:id="chkEmpresa" text="Facturar a una empresa (RUC)"/>
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" prefWidth="220"/>
                        <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="DNI del huésped *"/>
                        <TextField fx:id="txtDocumento" promptText="8 dígitos" onAction="#buscarCliente" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    </VBox>
                    <VBox fx:id="filaRuc" spacing="4" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="RUC de la empresa *"/>
                        <TextField fx:id="txtRuc" promptText="11 dígitos" onAction="#buscarCliente" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    </VBox>
                </GridPane>
                <HBox spacing="10">
                    <Button fx:id="btnBuscarCliente" text="Buscar local / autocompletar" onAction="#buscarCliente" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-background-color: #A87425; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Escribir datos manualmente" onAction="#escribirManual" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
                </HBox>
                <Label fx:id="lblEstadoBusqueda" wrapText="true" style="-fx-text-fill: #655C54;"/>

                <VBox fx:id="panelDatosEmpresa" spacing="8" visible="false" managed="false"
                      style="-fx-background-color: #F8F5F0; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text="Datos de empresa" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtRazonSocial" promptText="Razón social *" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                        <TextField fx:id="txtDireccionFiscal" promptText="Dirección fiscal" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    </HBox>
                </VBox>

                <VBox fx:id="panelDatosHuesped" spacing="8" visible="false" managed="false"
                      style="-fx-background-color: #F8F5F0; -fx-padding: 12; -fx-background-radius: 8;">
                    <Label text="Datos del huésped" style="-fx-font-weight: bold;"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <TextField fx:id="txtNombres" promptText="Nombres *" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                        <TextField fx:id="txtApellidos" promptText="Apellidos *" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                        <TextField fx:id="txtPais" promptText="País *" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                        <TextField fx:id="txtCorreo" promptText="Correo" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    </GridPane>
                </VBox>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="2. Fechas y ocupación" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox spacing="14">
                    <VBox spacing="4"><Label text="Ingreso *"/><DatePicker fx:id="dpFechaIngreso" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/></VBox>
                    <VBox spacing="4"><Label text="Salida *"/><DatePicker fx:id="dpFechaSalida" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/></VBox>
                    <VBox spacing="4"><Label text="Hora de llegada"/><ChoiceBox fx:id="cbHoraIngreso" prefWidth="120" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/></VBox>
                    <VBox spacing="4"><Label text="Huéspedes *"/><Spinner fx:id="spHuespedes" prefWidth="100" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/></VBox>
                    <VBox spacing="4"><Label text="Noches"/><Label fx:id="lblNoches" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold;"/></VBox>
                </HBox>
                <VBox fx:id="contenedorAcompanantes" spacing="8" visible="false" managed="false"/>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="3. Plano de habitaciones" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <ChoiceBox fx:id="cbPiso" prefWidth="180" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    <ChoiceBox fx:id="cbTipoHabitacion" prefWidth="220" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                </HBox>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="● Disponible en las fechas" style="-fx-text-fill: #27643B;"/>
                    <Label text="● No disponible" style="-fx-text-fill: #8A7C6A;"/>
                    <Label text="● Seleccionada" style="-fx-text-fill: #704313;"/>
                </HBox>
                <Label text="Selecciona una habitación del plano. El pasillo separa las dos alas del piso."
                       style="-fx-text-fill: #655C54;" wrapText="true"/>
                <VBox fx:id="contenedorHabitaciones" spacing="8">
                    <!-- Vista de ejemplo visible y editable en Scene Builder. En ejecución se sustituyen
                         estas habitaciones por las de MySQL para las fechas seleccionadas. -->
                    <Label fx:id="lblSinHabitaciones" text="Vista de referencia del plano · cargando disponibilidad"/>
                    <VBox spacing="8" style="-fx-background-color: #FAF8F4; -fx-background-radius: 10; -fx-border-color: #DDD4C8; -fx-border-radius: 10; -fx-padding: 14;">
                        <Label text="Piso 1 · Ala norte y ala sur" style="-fx-text-fill: #3B210F; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <GridPane hgap="8" vgap="8">
                            <Button text="101&#10;Simple" disable="true" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="102&#10;Doble" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="103&#10;Simple" disable="true" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #EEEAE5; -fx-border-color: #BDB4A9; -fx-text-fill: #756A5D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="104&#10;Matrimonial" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Label text="PASILLO CENTRAL  ·  ACCESO A HABITACIONES" style="-fx-alignment: center; -fx-background-color: #E8E0D5; -fx-background-radius: 5; -fx-padding: 9; -fx-text-fill: #5A3516; -fx-font-weight: bold;"
                                   maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="4"/>
                            <Button text="105&#10;Doble" disable="true" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="106&#10;Simple" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #EEEAE5; -fx-border-color: #BDB4A9; -fx-text-fill: #756A5D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="107&#10;Triple" disable="true" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                            <Button text="108&#10;Doble" disable="true" GridPane.columnIndex="3" GridPane.rowIndex="2" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-pref-width: 155; -fx-min-width: 135; -fx-min-height: 72; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 2; -fx-font-weight: bold; -fx-text-alignment: center; -fx-background-color: #E7F4E8; -fx-border-color: #79B78B; -fx-text-fill: #224D2D; -fx-opacity: 1; -fx-cursor: default;"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E8E2D9; -fx-border-radius: 10;">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                <Label text="4. Resumen y pago" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <GridPane hgap="18" vgap="8">
                    <Label text="Habitación" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblHabitacionResumen" text="--" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Noches" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblNochesResumen" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Precio por noche" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label fx:id="lblPrecioNoche" text="S/ 0.00" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Total" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Label fx:id="lblTotal" text="S/ 0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #A87425;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                </GridPane>
                <Label fx:id="lblAyudaPago" wrapText="true" style="-fx-text-fill: #655C54;"/>
                <HBox spacing="10">
                    <ChoiceBox fx:id="cbMetodoPago" prefWidth="180" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                    <TextField fx:id="txtMontoPago" promptText="Monto a pagar" prefWidth="160" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
                </HBox>
            </VBox>

            <HBox spacing="10">
                <Button text="Limpiar" onAction="#cancelarFormulario" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;"/>
                <Button text="Confirmar reserva" onAction="#confirmarReserva" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-background-color: #2E88DD; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
