<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="untrm.hotel_san_antonio.controlador.Reserva.CambiarHabitacionController"
    spacing="14" style="-fx-background-color: #F7F4EF; -fx-padding: 24;" prefWidth="600">
    <Label text="Cambiar habitación" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <Label fx:id="lblActual" wrapText="true"/>
    <Label text="Nueva habitación del mismo tipo o categoría superior"/>
    <ComboBox fx:id="cmbNueva" maxWidth="Infinity"/>
    <Label text="La diferencia de tarifa se calcula con los días pendientes y conserva todos los pagos." wrapText="true"/>
    <TextArea fx:id="txtMotivo" promptText="Motivo opcional" prefRowCount="3" wrapText="true"/>
    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Confirmar cambio" onAction="#guardar"/>
        <Button text="Cancelar" onAction="#cancelar"/>
    </HBox>
    <Label fx:id="lblMensaje" wrapText="true"/>
</VBox>
