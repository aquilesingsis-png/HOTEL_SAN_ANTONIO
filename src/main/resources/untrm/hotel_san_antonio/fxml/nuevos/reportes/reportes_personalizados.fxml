<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="REPORTES  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Reportes personalizados" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Define el período, las columnas y la agrupación del informe." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Configuración">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Alcance del informe" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Nombre del reporte" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtNombreDelReporte" maxWidth="Infinity" promptText="Nombre del reporte"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fuente" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbFuente" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Ocupación"/>
                                                        <String fx:value="Ventas de tienda"/>
                                                        <String fx:value="Ingresos"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Desde" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="dpDesde" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hasta" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="dpHasta" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Agrupar por" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbAgruparPor" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Día"/>
                                                        <String fx:value="Mes"/>
                                                        <String fx:value="Habitación"/>
                                                        <String fx:value="Producto"/>
                                                        <String fx:value="Método de pago"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Orden" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbOrden" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Ascendente"/>
                                                        <String fx:value="Descendente"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Columnas del resultado" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkPeriodo" maxWidth="Infinity" text="Período" wrapText="true"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkOrigen" maxWidth="Infinity" text="Origen" wrapText="true"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkConcepto" maxWidth="Infinity" text="Concepto" wrapText="true"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkCantidad" maxWidth="Infinity" text="Cantidad" wrapText="true"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkImporteS" maxWidth="Infinity" text="Importe (S/)" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Salida del reporte" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Formato" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbFormato" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="PDF"/>
                                                        <String fx:value="CSV"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkIncluirTotales" maxWidth="Infinity" text="Incluir totales" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormLimpiarConfiguracion" text="Limpiar configuración" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGenerarReporte" text="Generar reporte" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Resultado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Vista previa del reporte" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaGenerarVistaPrevia" text="Generar vista previa" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaImprimir" text="Imprimir" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaExportar" text="Exportar" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colPeriodo" text="Período" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colOrigen" text="Origen" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colImporteS" text="Importe (S/)" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Importes expresados en soles" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
