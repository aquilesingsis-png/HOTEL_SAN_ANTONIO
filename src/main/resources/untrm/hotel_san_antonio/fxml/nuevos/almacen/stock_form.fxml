<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: entrada, salida o conteo físico de un producto (solo Administrador). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.StockFormController"
      spacing="12" prefWidth="620" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
    <Label text="Ajustar stock" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <VBox spacing="4" style="-fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-padding: 12 14;">
        <Label fx:id="lblProducto" style="-fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
        <HBox spacing="6">
            <Label text="Stock actual:" style="-fx-text-fill: #5A3516;"/>
            <Label fx:id="lblStockActual" style="-fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
        </HBox>
    </VBox>
    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Tipo de movimiento *" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
            <ChoiceBox fx:id="cmbTipo" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Motivo *" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
            <ChoiceBox fx:id="cmbMotivo" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px;"/>
        </VBox>
    </HBox>
    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Cantidad *" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
            <TextField fx:id="txtCantidad" promptText="0" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Quedaría con" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
            <Label fx:id="lblResultado" text="—" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F; -fx-padding: 8 0 0 0;"/>
        </VBox>
    </HBox>
    <Label fx:id="lblAyuda" wrapText="true" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
    <VBox spacing="6">
        <Label text="Referencia / sustento" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
        <TextField fx:id="txtReferencia" promptText="Opcional: factura, guía, número de conteo" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Observaciones" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
        <TextArea fx:id="txtObservacion" prefRowCount="3" wrapText="true" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-prompt-text-fill: #847B70;"/>
    </VBox>
    <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #B64832;"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cerrar" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
        <Button text="Registrar movimiento" onAction="#guardar" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
    </HBox>
</VBox>
