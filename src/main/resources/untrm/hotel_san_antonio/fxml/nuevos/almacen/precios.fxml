<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="ALMACEN  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Precios" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Revisa precios de venta y prepara cambios por producto." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar producto o código" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarProductoOCodigo" maxWidth="Infinity" promptText="Buscar producto o código"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Todas las categorías"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Activo"/>
                                                        <String fx:value="Inactivo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de precios" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaSeleccionarProducto" text="Seleccionar producto" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaExportar" text="Exportar" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colProducto" text="Producto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colMarca" text="Marca" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colPrecioActualS" text="Precio actual (S/)" prefWidth="154" minWidth="90"/>
                                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Hotel San Antonio" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Formulario">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Producto seleccionado" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Código del producto" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtCodigoDelProducto" maxWidth="Infinity" promptText="Código del producto"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Producto" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtProducto" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Precio actual (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtPrecioActualS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Nuevo precio de venta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Nuevo precio (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtNuevoPrecioS" maxWidth="Infinity" promptText="Nuevo precio (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Variación (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtVariacionS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Variación (%)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtVariacion" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGuardarPrecio" text="Guardar precio" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
