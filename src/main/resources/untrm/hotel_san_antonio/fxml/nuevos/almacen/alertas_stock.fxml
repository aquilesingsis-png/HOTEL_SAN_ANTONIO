<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="ALMACEN  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Alertas de stock bajo" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Identifica productos agotados o por debajo del umbral de revisión." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar producto o código" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarProductoOCodigo" maxWidth="Infinity" promptText="Buscar producto o código"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Todas las categorías"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Umbral de revisión" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="filtroUmbralDeRevision" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Prioridad" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroPrioridad" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Agotado"/>
                                                        <String fx:value="Stock bajo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Productos agotados" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblProductosAgotados" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Productos con stock bajo" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblProductosConStockBajo" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Unidades por reponer" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblUnidadesPorReponer" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de alertas de stock bajo" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaConsultar" text="Consultar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaExportar" text="Exportar" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colProducto" text="Producto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colStockActual" text="Stock actual" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colUmbral" text="Umbral" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colUnidadesFaltantes" text="Unidades faltantes" prefWidth="154" minWidth="90"/>
                                            <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Hotel San Antonio" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Criterio de revisión" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="El umbral permite revisar existencias bajas. Los productos con stock cero se identifican como agotados." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
