<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="ALMACEN  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Productos" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Organiza el catálogo de productos que se venden en la tienda." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar nombre o código de barras" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarNombreOCodigoDeBarras" maxWidth="Infinity" promptText="Buscar nombre o código de barras"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Todas las categorías"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Activo"/>
                                                        <String fx:value="Inactivo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Productos activos" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblProductosActivos" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Unidades en stock" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblUnidadesEnStock" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Categorías" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblCategorias" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del inventario" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de productos" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaNuevo" text="+ Nuevo" styleClass="primary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaEditar" text="Editar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCodigoDeBarras" text="Código de barras" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colProducto" text="Producto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colMarca" text="Marca" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colPrecioS" text="Precio (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colStock" text="Stock" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Hotel San Antonio" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Nuevo / editar">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Identificación del producto" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Código" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtCodigo" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Código de barras" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtCodigoDeBarras" maxWidth="Infinity" promptText="Código de barras"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Nombre del producto" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtNombreDelProducto" maxWidth="Infinity" promptText="Nombre del producto"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Marca" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtMarca" maxWidth="Infinity" promptText="Marca"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList"/>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Venta y disponibilidad" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Precio de venta (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtPrecioDeVentaS" maxWidth="Infinity" promptText="Precio de venta (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Stock inicial" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnStockInicial" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Activo"/>
                                                        <String fx:value="Inactivo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormLimpiar" text="Limpiar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGuardarProducto" text="Guardar producto" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
