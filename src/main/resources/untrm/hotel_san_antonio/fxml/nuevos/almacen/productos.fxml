<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <top>
        <VBox spacing="7" style="-fx-padding: 22 26 18 26; -fx-background-color: white; -fx-border-color: #E7E1D8; -fx-border-width: 0 0 1 0;">
            <Label text="ALMACEN  /  HOTEL SAN ANTONIO" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #8A601D; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Label text="Productos" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
            <Label text="Organiza el catálogo de productos que se venden en la tienda." wrapText="true" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-text-fill: #6A5F52;"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0" userData="tabs-nuevos">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" style="-fx-background: #F8F6F2; -fx-background-color: #F8F6F2; -fx-background-insets: 0; -fx-padding: 0;">
                        <content>
                            <VBox spacing="18" fillWidth="true" style="-fx-padding: 20 24 26 24; -fx-background-color: #F8F6F2;">
                                <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                                    <Label text="Filtros de consulta" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar nombre o código de barras" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="filtroBuscarNombreOCodigoDeBarras" maxWidth="Infinity" promptText="Buscar nombre o código de barras" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <ComboBox fx:id="filtroCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Todas las categorías"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <ComboBox fx:id="filtroEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Activo"/>
                                                        <String fx:value="Inactivo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                        <Label text="Productos activos" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                        <Label fx:id="lblProductosActivos" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                        <Label text="Resumen del inventario" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                        <Label text="Unidades en stock" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                        <Label fx:id="lblUnidadesEnStock" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                        <Label text="Resumen del inventario" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                        <Label text="Categorías" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                        <Label fx:id="lblCategorias" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                        <Label text="Resumen del inventario" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                                    <Label text="Detalle de productos" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaNuevo" text="+ Nuevo" mnemonicParsing="false" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                        <Button fx:id="btnListaEditar" text="Editar" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS" userData="tabla-nuevos" style="-fx-background-color: white; -fx-border-color: #E8E2D9; -fx-border-color: #E7E1D8; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0; -fx-fixed-cell-size: 40;">
                                        <columns>
                                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCodigoDeBarras" text="Código de barras" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colProducto" text="Producto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colMarca" text="Marca" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colPrecioS" text="Precio (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colStock" text="Stock" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #5A3516; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Hotel San Antonio" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Nuevo / editar">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" style="-fx-background: #F8F6F2; -fx-background-color: #F8F6F2; -fx-background-insets: 0; -fx-padding: 0;">
                        <content>
                            <VBox spacing="18" fillWidth="true" style="-fx-padding: 20 24 26 24; -fx-background-color: #F8F6F2;">
                                <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                                    <Label text="Identificación del producto" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Código" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="txtCodigo" maxWidth="Infinity" text="—" editable="false" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70; -fx-background-color: #F3EEE7; -fx-text-fill: #6A5F52;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Código de barras" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="txtCodigoDeBarras" maxWidth="Infinity" promptText="Código de barras" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Nombre del producto" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="txtNombreDelProducto" maxWidth="Infinity" promptText="Nombre del producto" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Marca" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="txtMarca" maxWidth="Infinity" promptText="Marca" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Categoría" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList"/>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                                    <Label text="Venta y disponibilidad" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Precio de venta (S/)" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <TextField fx:id="txtPrecioDeVentaS" maxWidth="Infinity" promptText="Precio de venta (S/)" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Stock inicial" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <Spinner fx:id="spnStockInicial" maxWidth="Infinity" editable="true" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37;">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" wrapText="true" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Activo"/>
                                                        <String fx:value="Inactivo"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                    <Button fx:id="btnFormLimpiar" text="Limpiar" mnemonicParsing="false" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                                    <Button fx:id="btnFormGuardarProducto" text="Guardar producto" mnemonicParsing="false" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
