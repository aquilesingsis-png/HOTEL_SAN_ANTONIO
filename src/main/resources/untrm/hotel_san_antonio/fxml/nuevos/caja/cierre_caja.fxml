<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="CAJA  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Cierre de caja" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Compara el saldo esperado con el efectivo entregado al finalizar el turno." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar cierre o responsable" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarCierreOResponsable" maxWidth="Infinity" promptText="Buscar cierre o responsable"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Desde" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroDesde" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hasta" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroHasta" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Estado" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroEstado" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Abierto"/>
                                                        <String fx:value="Cerrado"/>
                                                        <String fx:value="Con diferencia"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Efectivo esperado (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblEfectivoEsperadoS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Efectivo contado (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblEfectivoContadoS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Diferencia (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblDiferenciaS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de cierre de caja" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaNuevo" text="+ Nuevo" styleClass="primary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaImprimir" text="Imprimir" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colNOCierre" text="N.º cierre" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colTurno" text="Turno" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEsperadoS" text="Esperado (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colContadoS" text="Contado (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colDiferenciaS" text="Diferencia (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Importes expresados en soles" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Formulario">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Turno a cerrar" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fecha del cierre" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="dpFechaDelCierre" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Turno / caja" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTurnoCaja" maxWidth="Infinity" promptText="Turno / caja"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Responsable" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtResponsable" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hora de apertura" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtHoraDeApertura" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hora de cierre" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtHoraDeCierre" maxWidth="Infinity" promptText="Hora de cierre"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Conciliación de efectivo" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fondo inicial (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtFondoInicialS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Cobros en efectivo (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtCobrosEnEfectivoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Otros ingresos de efectivo (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtOtrosIngresosDeEfectivoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Salidas de efectivo (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtSalidasDeEfectivoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Efectivo esperado (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtEfectivoEsperadoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Efectivo contado (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtEfectivoContadoS" maxWidth="Infinity" promptText="Efectivo contado (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Diferencia (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtDiferenciaS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Efectivo entregado (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtEfectivoEntregadoS" maxWidth="Infinity" promptText="Efectivo entregado (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fondo para siguiente turno (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtFondoParaSiguienteTurnoS" maxWidth="Infinity" promptText="Fondo para siguiente turno (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Observaciones del cierre" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextArea fx:id="txtObservacionesDelCierre" maxWidth="Infinity" promptText="Observaciones del cierre" wrapText="true" prefRowCount="3"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <CheckBox fx:id="chkHeRevisadoLosImportesDelCierre" maxWidth="Infinity" text="He revisado los importes del cierre" wrapText="true"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGuardarBorrador" text="Guardar borrador" styleClass="primary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormConfirmarCierre" text="Confirmar cierre" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
