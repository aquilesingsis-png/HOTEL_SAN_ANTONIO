<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Cierre de caja con el arqueo adentro: se cuenta el efectivo por billetes y monedas, el contado y la
     diferencia salen solos, y al confirmar se guardan el cierre y el arqueo del turno. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.CierreCajaController" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" style="-fx-background: #F8F6F2; -fx-background-color: #F8F6F2; -fx-background-insets: 0; -fx-padding: 0;">
            <content>
                <VBox spacing="18" fillWidth="true" style="-fx-padding: 20 24 26 24; -fx-background-color: #F8F6F2;">

                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="1. Turno que se cierra" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <FlowPane hgap="14" vgap="12">
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Fecha del cierre" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="dpFecha" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="230">
                                <Label text="Turno / caja" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtTurno" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="150">
                                <Label text="Hora de cierre (HH:mm)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtHoraCierre" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="260">
                                <Label text="Responsable" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <Label fx:id="lblResponsable" text="—" style="-fx-padding: 9 0 0 0; -fx-font-weight: bold;"/>
                            </VBox>
                        </FlowPane>
                    </VBox>

                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="2. Efectivo esperado (se calcula solo con los cobros, ingresos y salidas del día)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <FlowPane hgap="14" vgap="12">
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Fondo inicial (S/)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtFondoInicial" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Cobros en efectivo (S/)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtCobros" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Otros ingresos (S/)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtOtros" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="190">
                                <Label text="Salidas de efectivo (S/)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtSalidas" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="200">
                                <Label text="Efectivo esperado" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <Label fx:id="lblEsperado" text="S/ 0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                            </VBox>
                        </FlowPane>
                    </VBox>

                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="3. Arqueo: cuenta el efectivo por billetes y monedas" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <HBox spacing="48">
                            <VBox spacing="8">
                                <Label text="Billetes" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <GridPane fx:id="gridBilletes" hgap="12" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150"/>
                                        <ColumnConstraints minWidth="110"/>
                                        <ColumnConstraints minWidth="90"/>
                                    </columnConstraints>
                                </GridPane>
                                <HBox spacing="12">
                                    <Label text="Total billetes" style="-fx-font-weight: bold; -fx-min-width: 150;"/>
                                    <Label fx:id="lblTotalBilletes" text="S/ 0.00" style="-fx-font-weight: bold;"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="8">
                                <Label text="Monedas" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <GridPane fx:id="gridMonedas" hgap="12" vgap="8">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150"/>
                                        <ColumnConstraints minWidth="110"/>
                                        <ColumnConstraints minWidth="90"/>
                                    </columnConstraints>
                                </GridPane>
                                <HBox spacing="12">
                                    <Label text="Total monedas" style="-fx-font-weight: bold; -fx-min-width: 150;"/>
                                    <Label fx:id="lblTotalMonedas" text="S/ 0.00" style="-fx-font-weight: bold;"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Efectivo contado" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <Label fx:id="lblContado" text="S/ 0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="4. Resultado y entrega del efectivo" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <FlowPane hgap="12" vgap="12">
                            <VBox spacing="8" prefWidth="215" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                <Label text="Esperado" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                <Label fx:id="lblResumenEsperado" text="S/ 0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="215" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                <Label text="Contado" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                <Label fx:id="lblResumenContado" text="S/ 0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="215" style="-fx-padding: 17; -fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-border-color: #E8D6B3; -fx-border-radius: 8;">
                                <Label text="Diferencia" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                                <Label fx:id="lblDiferencia" text="S/ 0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                                <Label fx:id="lblDiferenciaTexto" text="La caja cuadra"/>
                            </VBox>
                        </FlowPane>
                        <FlowPane hgap="14" vgap="12">
                            <VBox spacing="6" prefWidth="260">
                                <Label text="Fondo para el siguiente turno (S/)" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtFondoSiguiente" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="260">
                                <Label text="Efectivo que se entrega" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                                <Label fx:id="lblEntregado" text="S/ 0.00" style="-fx-padding: 9 0 0 0; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </VBox>
                        </FlowPane>
                        <VBox spacing="6">
                            <Label text="Observaciones del cierre" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
                            <TextArea fx:id="txtObservacion" prefRowCount="3" wrapText="true" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-prompt-text-fill: #847B70;"/>
                        </VBox>
                        <CheckBox fx:id="chkRevisado" text="He revisado los importes del cierre"/>
                        <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #B64832;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Confirmar cierre" onAction="#confirmarCierre" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
                            <Button text="Guardar borrador" onAction="#guardarBorrador" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                            <Button text="Limpiar conteo" onAction="#limpiar" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Actualizar datos del turno" onAction="#cargarTurno" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                        <Label text="Historial de cierres" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                        <TableView fx:id="tablaCierres" minHeight="200" prefHeight="260" userData="tabla-nuevos" style="-fx-background-color: white; -fx-border-color: #E8E2D9; -fx-border-color: #E7E1D8; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0; -fx-fixed-cell-size: 40;">
                            <columns>
                                <TableColumn fx:id="colNumero" text="N.º cierre" prefWidth="90"/>
                                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                                <TableColumn fx:id="colTurno" text="Turno" prefWidth="160"/>
                                <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="190"/>
                                <TableColumn fx:id="colEsperado" text="Esperado" prefWidth="110"/>
                                <TableColumn fx:id="colContado" text="Contado" prefWidth="110"/>
                                <TableColumn fx:id="colDiferencia" text="Diferencia" prefWidth="110"/>
                                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8">
                                    <Label text="Todavía no hay cierres" style="-fx-text-fill: #5A3516; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                                    <Label text="El primer cierre confirmado aparecerá aquí." style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
