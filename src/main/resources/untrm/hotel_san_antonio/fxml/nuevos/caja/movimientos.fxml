<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="CAJA  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Movimientos de caja" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Revisa ingresos, salidas y referencias del turno de caja." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar concepto o referencia" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarConceptoOReferencia" maxWidth="Infinity" promptText="Buscar concepto o referencia"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Desde" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroDesde" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hasta" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroHasta" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Tipo" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroTipo" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Ingreso"/>
                                                        <String fx:value="Egreso"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Método de pago" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroMetodoDePago" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Efectivo"/>
                                                        <String fx:value="Yape"/>
                                                        <String fx:value="Transferencia"/>
                                                        <String fx:value="Tarjeta"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Ingresos (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblIngresosS" text="—" styleClass="metric-value"/>
                                        <Label text="Período seleccionado" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Egresos (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblEgresosS" text="—" styleClass="metric-value"/>
                                        <Label text="Período seleccionado" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Neto (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblNetoS" text="—" styleClass="metric-value"/>
                                        <Label text="Período seleccionado" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de movimientos de caja" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaNuevo" text="+ Nuevo" styleClass="primary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaExportar" text="Exportar" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colFechaYHora" text="Fecha y hora" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colNOMovimiento" text="N.º movimiento" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colReferencia" text="Referencia" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colMetodo" text="Método" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEntradaS" text="Entrada (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colSalidaS" text="Salida (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Importes expresados en soles" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Formulario">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Identificación del movimiento" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fecha" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Turno / caja" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTurnoCaja" maxWidth="Infinity" promptText="Turno / caja"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Tipo" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Ingreso"/>
                                                        <String fx:value="Egreso"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Concepto" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbConcepto" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Fondo de apertura"/>
                                                        <String fx:value="Ingreso adicional"/>
                                                        <String fx:value="Gasto operativo"/>
                                                        <String fx:value="Retiro de efectivo"/>
                                                        <String fx:value="Ajuste de caja"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Importe y respaldo" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Método de pago" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="cmbMetodoDePago" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Efectivo"/>
                                                        <String fx:value="Yape"/>
                                                        <String fx:value="Transferencia"/>
                                                        <String fx:value="Tarjeta"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monto (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtMontoS" maxWidth="Infinity" promptText="Monto (S/)"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Referencia / sustento" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtReferenciaSustento" maxWidth="Infinity" promptText="Referencia / sustento"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Responsable" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtResponsable" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Observaciones" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextArea fx:id="txtObservaciones" maxWidth="Infinity" promptText="Observaciones" wrapText="true" prefRowCount="3"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormLimpiar" text="Limpiar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGuardarMovimiento" text="Guardar movimiento" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
