<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="CAJA  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Arqueo de caja" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Registra billetes y monedas para contrastar el efectivo disponible." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar arqueo o responsable" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarArqueoOResponsable" maxWidth="Infinity" promptText="Buscar arqueo o responsable"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Desde" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroDesde" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hasta" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroHasta" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Esperado (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblEsperadoS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Contado (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblContadoS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="8" prefWidth="248" styleClass="metric">
                                        <Label text="Diferencia (S/)" styleClass="metric-label" wrapText="true" maxWidth="Infinity"/>
                                        <Label fx:id="lblDiferenciaS" text="—" styleClass="metric-value"/>
                                        <Label text="Resumen del turno" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </VBox>
                                </FlowPane>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de arqueo de caja" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaNuevo" text="+ Nuevo" styleClass="primary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaImprimir" text="Imprimir" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colNOArqueo" text="N.º arqueo" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colFechaYHora" text="Fecha y hora" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colTurno" text="Turno" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colEsperadoS" text="Esperado (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colContadoS" text="Contado (S/)" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colDiferenciaS" text="Diferencia (S/)" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Importes expresados en soles" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Formulario">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Datos del arqueo" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Fecha" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Turno / caja" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTurnoCaja" maxWidth="Infinity" promptText="Turno / caja"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Responsable" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtResponsable" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Efectivo esperado (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtEfectivoEsperadoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Billetes · cantidad por denominación" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Billetes de S/ 200" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnBilletesDeS200" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Billetes de S/ 100" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnBilletesDeS100" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Billetes de S/ 50" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnBilletesDeS50" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Billetes de S/ 20" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnBilletesDeS20" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Billetes de S/ 10" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnBilletesDeS10" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Monedas · cantidad por denominación" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 5.00" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS500" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 2.00" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS200" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 1.00" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS100" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 0.50" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS050" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 0.20" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS020" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Monedas de S/ 0.10" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <Spinner fx:id="spnMonedasDeS010" maxWidth="Infinity" editable="true">
                                                <valueFactory>
                                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="0"/>
                                                </valueFactory>
                                            </Spinner>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Resultado del conteo" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Total billetes (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTotalBilletesS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Total monedas (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTotalMonedasS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Total contado (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtTotalContadoS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Diferencia (S/)" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="txtDiferenciaS" maxWidth="Infinity" text="—" editable="false" styleClass="readonly"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="248" minWidth="180" maxWidth="Infinity">
                                            <Label text="Observaciones" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextArea fx:id="txtObservaciones" maxWidth="Infinity" promptText="Observaciones" wrapText="true" prefRowCount="3"/>
                                        </VBox>
                                    </FlowPane>
                                </VBox>
                                <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                    <Button fx:id="btnFormCancelar" text="Cancelar" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormLimpiarConteo" text="Limpiar conteo" styleClass="secondary" mnemonicParsing="false"/>
                                    <Button fx:id="btnFormGuardarArqueo" text="Guardar arqueo" styleClass="primary" mnemonicParsing="false"/>
                                </FlowPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
