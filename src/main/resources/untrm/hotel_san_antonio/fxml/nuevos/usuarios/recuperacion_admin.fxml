<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana emergente: código de un solo uso para que un empleado cree una contraseña nueva (solo Administrador). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="untrm.hotel_san_antonio.controlador.EmisionRecuperacionController"
      spacing="12" prefWidth="620" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
    <Label text="Restablecer acceso" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    <VBox spacing="4" style="-fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-padding: 12 14;">
        <Label text="Usuario" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
        <Label fx:id="lblUsuario" style="-fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
    </VBox>
    <Label text="Verifique la identidad del empleado y entréguele el código por un medio confiable. El código sirve una sola vez, vence en 15 minutos y reemplaza a cualquier código anterior. El empleado lo escribe en «Recuperar contraseña» de la pantalla de ingreso." wrapText="true" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
    <HBox>
        <Button fx:id="btnGenerar" text="Generar código de un solo uso" onAction="#emitir" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
    </HBox>
    <VBox spacing="6">
        <Label text="Código" style="-fx-font-size: 12px; -fx-text-fill: #4A3826; -fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="txtToken" editable="false" promptText="El código aparecerá aquí" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #D9D1C5; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-pref-height: 37; -fx-min-height: 37; -fx-prompt-text-fill: #847B70;"/>
            <Button fx:id="btnCopiar" text="Copiar" onAction="#copiar" disable="true" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
        </HBox>
    </VBox>
    <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #B64832;"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar" onAction="#cerrar" userData="secondary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: white; -fx-border-color: #BBA78E; -fx-text-fill: #5A3516;"/>
    </HBox>
</VBox>
