<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<!-- Interfaz visual independiente: sin controlador ni acciones de negocio. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="nuevos" stylesheets="@../css/nuevos-modulos.css" prefWidth="1050" prefHeight="760" minWidth="0" minHeight="300">
    <top>
        <VBox spacing="7" styleClass="page-header">
            <Label text="USUARIOS  /  HOTEL SAN ANTONIO" styleClass="eyebrow" wrapText="true" maxWidth="Infinity"/>
            <Label text="Historial de usuarios" styleClass="page-title" wrapText="true" maxWidth="Infinity"/>
            <Label text="Consulta cambios de acceso y actividad administrativa del personal." styleClass="subtitle" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabsModulo" tabClosingPolicy="UNAVAILABLE" minWidth="0">
            <Tab text="Listado">
                <content>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="content-scroll">
                        <content>
                            <VBox spacing="18" fillWidth="true" styleClass="page-content">
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Filtros de consulta" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Buscar usuario" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <TextField fx:id="filtroBuscarUsuario" maxWidth="Infinity" promptText="Buscar usuario"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Desde" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroDesde" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Hasta" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <DatePicker fx:id="filtroHasta" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                                        </VBox>
                                        <VBox spacing="7" prefWidth="218" minWidth="180" maxWidth="Infinity">
                                            <Label text="Acción" styleClass="field-label" wrapText="true" maxWidth="Infinity"/>
                                            <ComboBox fx:id="filtroAccion" maxWidth="Infinity" promptText="Seleccionar" visibleRowCount="8">
                                                <items>
                                                    <FXCollections fx:factory="observableArrayList">
                                                        <String fx:value="Creación de usuario"/>
                                                        <String fx:value="Edición de datos"/>
                                                        <String fx:value="Cambio de rol"/>
                                                        <String fx:value="Activación"/>
                                                        <String fx:value="Desactivación"/>
                                                    </FXCollections>
                                                </items>
                                            </ComboBox>
                                        </VBox>
                                    </FlowPane>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnFiltroBuscar" text="Buscar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnFiltroLimpiarFiltros" text="Limpiar filtros" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="16" styleClass="card">
                                    <Label text="Detalle de historial de usuarios" styleClass="section-title" wrapText="true" maxWidth="Infinity"/>
                                    <FlowPane hgap="12" vgap="12" prefWrapLength="960">
                                        <Button fx:id="btnListaConsultar" text="Consultar" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaActualizarLista" text="Actualizar lista" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaVerDetalle" text="Ver detalle" styleClass="secondary" mnemonicParsing="false"/>
                                        <Button fx:id="btnListaExportar" text="Exportar" styleClass="secondary" mnemonicParsing="false"/>
                                    </FlowPane>
                                    <TableView fx:id="tblRegistros" minHeight="240" prefHeight="330" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colFechaYHora" text="Fecha y hora" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colUsuarioAfectado" text="Usuario afectado" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colAccion" text="Acción" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colValorAnterior" text="Valor anterior" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colValorNuevo" text="Valor nuevo" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colRealizadoPor" text="Realizado por" prefWidth="145" minWidth="90"/>
                                            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="145" minWidth="90"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="Sin registros para mostrar" styleClass="empty-title" wrapText="true" maxWidth="Infinity"/>
                                                <Label text="Los resultados de la consulta aparecerán en este listado." styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="0 registros" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Hotel San Antonio" styleClass="muted" wrapText="true" maxWidth="Infinity"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
