<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Respaldo: copia de toda la base de datos en un archivo .sql (solo Administrador). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="untrm.hotel_san_antonio.controlador.RespaldoController" prefWidth="1050" prefHeight="700" minWidth="0" minHeight="300" style="-fx-background-color: #F8F6F2; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #2B2B2B; -fx-accent: #B8862D; -fx-focus-color: #B8862D; -fx-faint-focus-color: #F5E6C8;">
    <center>
        <VBox spacing="18" fillWidth="true" style="-fx-padding: 20 24 26 24; -fx-background-color: #F8F6F2;">
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                <Label text="Respaldo de la base de datos" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                <Label fx:id="lblUltimo" text="—" wrapText="true"/>
                <Label text="Guarda una copia de toda la información del hotel (reservas, pagos, caja, productos, usuarios) en un archivo. Elige una carpeta fuera de esta computadora, por ejemplo un USB o una carpeta sincronizada con la nube: si la computadora se daña, la copia sigue a salvo." wrapText="true" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="btnCrear" text="Crear respaldo ahora" onAction="#crear" userData="primary" style="-fx-background-color: #A87425; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand; -fx-padding: 9 17; -fx-background-radius: 4; -fx-border-radius: 4; -fx-font-size: 13px; -fx-min-height: 37; -fx-background-color: #B8862D; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #B8862D;"/>
                    <ProgressBar fx:id="barra" progress="-1" prefWidth="180"/>
                    <Label fx:id="lblEstado" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
                </HBox>
                <VBox fx:id="cajaResultado" spacing="4" style="-fx-background-color: #F5E6C8; -fx-background-radius: 8; -fx-padding: 12 14;">
                    <Label text="Archivo guardado en" style="-fx-text-fill: #5A3516; -fx-font-size: 12px;"/>
                    <Label fx:id="lblArchivo" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                    <Label fx:id="lblDetalle" style="-fx-text-fill: #5A3516;"/>
                </VBox>
            </VBox>
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-padding: 18;">
                <Label text="Cómo restaurar un respaldo" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3B210F;"/>
                <Label text="1. Abre phpMyAdmin (http://localhost/phpmyadmin) y entra a la base hotel_san_antonio." wrapText="true"/>
                <Label text="2. Ve a la pestaña Importar, elige el archivo .sql y pulsa Continuar." wrapText="true"/>
                <Label text="3. Atención: al importar se reemplazan los datos actuales por los del respaldo. Hazlo con el sistema cerrado." wrapText="true"/>
                <Label text="La restauración se hace fuera del sistema a propósito: así nadie borra los datos del día por error desde una pantalla." wrapText="true" style="-fx-text-fill: #777777; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
