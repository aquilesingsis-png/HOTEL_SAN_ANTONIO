# Copia este archivo como "config.properties" (sin .example) en la misma carpeta
# (junto a pom.xml). Ese archivo SI tiene los tokens reales y NUNCA se sube a Git
# (ya esta en .gitignore). Pide los valores reales al equipo, no los inventes.

reniec.token=PEGAR_TOKEN_AQUI
sunat.ruc.token=PEGAR_TOKEN_AQUI
decolecta.token=PEGAR_TOKEN_AQUI

# Base MySQL. Puede configurar estas claves o usar HOTEL_DB_URL, HOTEL_DB_USER
# y HOTEL_DB_PASSWORD en el entorno de NetBeans.
db.url=jdbc:mysql://localhost:3306/hotel_san_antonio?serverTimezone=America/Lima
db.user=root
db.password=
